digraph "toggle_sync_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>toggle_sync</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/cdc/toggle_sync/src/toggle_sync.sv; clocks / resets (not drawn): dst_clk, dst_rst_n, src_clk, src_rst_n<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:event_i" }
    "in:event_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="event_i"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:event_o" "out:toggle_o" }
    "out:event_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="event_o"];
    "out:toggle_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="toggle_o"];
  }
  subgraph cluster_b0 { label="always_ff @ line 30"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:tog" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="tog"];
  }
  subgraph cluster_b1 { label="always_ff @ line 36"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:tog_d" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="tog_d"];
  }
  "sig:tog_s" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="tog_s"];
  "inst:u_sync" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>bit_sync</B><BR/><FONT COLOR="#4b5563">u_sync</FONT>>];
  "in:event_i" -> "sig:tog";
  "inst:u_sync" -> "sig:tog_s";
  "sig:tog" -> "inst:u_sync";
  "sig:tog" -> "sig:tog";
  "sig:tog_d" -> "out:event_o";
  "sig:tog_s" -> "out:event_o";
  "sig:tog_s" -> "out:toggle_o";
  "sig:tog_s" -> "sig:tog_d";
}
