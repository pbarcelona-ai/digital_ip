digraph "toggle_sync" {
  graph [rankdir=LR, bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.65, label="toggle_sync RTL hierarchy", labelloc=t, fontname="Helvetica", fontsize=16];
  node [shape=box, fontname="Helvetica", fontsize=10, margin="0.14,0.08"];
  edge [color="#52635c", arrowsize=0.7];
  n0 [label="toggle_sync\n(top)", style="rounded,filled", fillcolor="#dcefe8", color="#176b59"];
  n1 [label="bit_sync\n(u_sync)", style="rounded,filled", fillcolor="#f4f6f5", color="#71817a"];
  n0 -> n1;
}
