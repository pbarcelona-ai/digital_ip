digraph "axis_async_bridge_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>axis_async_bridge</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/cdc/axis_async_bridge/src/axis_async_bridge.sv; clocks / resets (not drawn): m_clk, m_rst_n, s_clk, s_rst_n<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:m_axis_*" "in:s_axis_*" }
    "in:m_axis_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="m_axis_tready"];
    "in:s_axis_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="s_axis_*\ns_axis_tdata\ns_axis_tkeep\ns_axis_tlast\ns_axis_tuser\ns_axis_tvalid"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:m_axis_*" "out:s_axis_*" }
    "out:m_axis_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="m_axis_*\nm_axis_tdata\nm_axis_tkeep\nm_axis_tlast\nm_axis_tuser\nm_axis_tvalid"];
    "out:s_axis_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="s_axis_tready"];
  }
  subgraph cluster_b0 { label="always_ff @ line 47"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:s_rs" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="s_rs\n[1:0]"];
  }
  subgraph cluster_b1 { label="always_ff @ line 49"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:m_rs" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="m_rs\n[1:0]"];
  }
  "sig:rd" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="rd\n[W-1:0]"];
  "sig:rvalid" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="rvalid"];
  "sig:wd" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="wd\n[W-1:0]"];
  "sig:wl" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="wl\n[$clog2(DEPTH):0]"];
  "sig:wready" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="wready"];
  "inst:u_fifo" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>async_fifo</B><BR/><FONT COLOR="#4b5563">u_fifo</FONT>>];
  "in:m_axis_*" -> "inst:u_fifo";
  "in:s_axis_*" -> "inst:u_fifo";
  "in:s_axis_*" -> "sig:wd";
  "inst:u_fifo" -> "sig:rd";
  "inst:u_fifo" -> "sig:rvalid";
  "inst:u_fifo" -> "sig:wl";
  "inst:u_fifo" -> "sig:wready";
  "sig:m_rs" -> "inst:u_fifo";
  "sig:m_rs" -> "sig:m_rs";
  "sig:rd" -> "out:m_axis_*";
  "sig:rvalid" -> "out:m_axis_*";
  "sig:s_rs" -> "inst:u_fifo";
  "sig:s_rs" -> "out:s_axis_*";
  "sig:s_rs" -> "sig:s_rs";
  "sig:wd" -> "inst:u_fifo";
  "sig:wready" -> "out:s_axis_*";
}
