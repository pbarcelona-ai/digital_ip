digraph "axi4_lite_cdc_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>axi4_lite_cdc</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/cdc/axi4_lite_cdc/src/axi4_lite_cdc.sv; clocks / resets (not drawn): m_clk, m_rst_n, s_clk, s_rst_n<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:m_axil_*" "in:s_axil_*" }
    "in:m_axil_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="m_axil_*\nm_axil_awready\nm_axil_wready\nm_axil_bresp\nm_axil_bvalid\nm_axil_arready\nm_axil_rdata\nm_axil_rresp\nm_axil_rvalid"];
    "in:s_axil_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="s_axil_*\ns_axil_awaddr\ns_axil_awvalid\ns_axil_wdata\ns_axil_wstrb\ns_axil_wvalid\ns_axil_bready\ns_axil_araddr\ns_axil_arvalid\ns_axil_rready"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:m_axil_*" "out:s_axil_*" }
    "out:m_axil_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="m_axil_*\nm_axil_awaddr\nm_axil_awvalid\nm_axil_wdata\nm_axil_wstrb\nm_axil_wvalid\nm_axil_bready\nm_axil_araddr\nm_axil_arvalid\nm_axil_rready"];
    "out:s_axil_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="s_axil_*\ns_axil_awready\ns_axil_wready\ns_axil_bresp\ns_axil_bvalid\ns_axil_arready\ns_axil_rdata\ns_axil_rresp\ns_axil_rvalid"];
  }
  subgraph cluster_b0 { label="always_ff @ line 134"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:ack_tog" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="ack_tog"];
    "sig:aw_done" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="aw_done"];
    "sig:ds" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="ds"];
    "sig:req_prev" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="req_prev"];
    "sig:rsp_rdata" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="rsp_rdata\n[31:0]"];
    "sig:rsp_resp" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="rsp_resp\n[1:0]"];
    "sig:w_done" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="w_done"];
  }
  subgraph cluster_b1 { label="always_ff @ line 82"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:ack_prev" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="ack_prev"];
    "sig:aw_seen" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="aw_seen"];
    "sig:req_addr" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="req_addr\n[ADDR_W-1:0]"];
    "sig:req_is_wr" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="req_is_wr"];
    "sig:req_tog" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="req_tog"];
    "sig:req_wdata" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="req_wdata\n[31:0]"];
    "sig:req_wstrb" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="req_wstrb\n[3:0]"];
    "sig:ss" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="ss"];
    "sig:w_seen" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="w_seen"];
  }
  "sig:ack_tog_sync" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="ack_tog_sync"];
  "sig:req_tog_sync" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="req_tog_sync"];
  "inst:u_ack_sync" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>cdc_sync_bit</B><BR/><FONT COLOR="#4b5563">u_ack_sync</FONT>>];
  "inst:u_req_sync" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>cdc_sync_bit</B><BR/><FONT COLOR="#4b5563">u_req_sync</FONT>>];
