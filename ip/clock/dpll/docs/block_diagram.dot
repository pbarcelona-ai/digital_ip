digraph "dpll" {
  graph [rankdir=LR, bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.65, label="dpll RTL hierarchy", labelloc=t, fontname="Helvetica", fontsize=16];
  node [shape=box, fontname="Helvetica", fontsize=10, margin="0.14,0.08"];
  edge [color="#52635c", arrowsize=0.7];
  n0 [label="dpll\n(top)", style="rounded,filled", fillcolor="#dcefe8", color="#176b59"];
  n1 [label="dpll_ctrl\n(u_ctrl)", style="rounded,filled", fillcolor="#f4f6f5", color="#71817a"];
  n2 [label="dpll_dco\n(u_dco)", style="rounded,filled", fillcolor="#f4f6f5", color="#71817a"];
  n0 -> n1;
  n0 -> n2;
}
