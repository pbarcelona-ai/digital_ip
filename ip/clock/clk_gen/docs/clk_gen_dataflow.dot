digraph "clk_gen_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>clk_gen</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/clock/clk_gen/src/clk_gen.sv; clocks / resets (not drawn): arst_n, ref_clk<BR ALIGN="LEFT"/>clock / reset only (not drawn): reset_sync u_rst_ref<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:clk_en_i" }
    "in:clk_en_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="clk_en_i\n[NCLK-1:0]"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:clk_locked_o" "out:clk_o" "out:cpu_clk_o" "out:cpu_locked_o" }
    "out:clk_locked_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="clk_locked_o"];
    "out:clk_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="clk_o\n[NCLK-1:0]"];
    "out:cpu_clk_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="cpu_clk_o"];
    "out:cpu_locked_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="cpu_locked_o"];
  }
  "sig:cpu_ok" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="cpu_ok"];
  "sig:lock_cpu" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="lock_cpu"];
  "inst:u_pll_cpu" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>dpll</B><BR/><FONT COLOR="#4b5563">u_pll_cpu</FONT>>];
  "inst:u_lock_cpu" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>reset_sync</B><BR/><FONT COLOR="#4b5563">u_lock_cpu</FONT>>];
  "inst:u_pll_clk" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>dpll</B><BR/><FONT COLOR="#4b5563">u_pll_clk</FONT>>];
  "in:clk_en_i" -> "inst:u_pll_clk";
  "inst:u_lock_cpu" -> "out:cpu_locked_o";
  "inst:u_pll_clk" -> "out:clk_o";
  "inst:u_pll_cpu" -> "out:cpu_clk_o";
  "inst:u_pll_cpu" -> "sig:lock_cpu";
  "out:cpu_clk_o" -> "inst:u_lock_cpu";
  "out:cpu_clk_o" -> "inst:u_pll_clk";
  "out:cpu_locked_o" -> "inst:u_pll_clk";
  "out:cpu_locked_o" -> "out:clk_locked_o";
  "sig:cpu_ok" -> "inst:u_lock_cpu";
  "sig:lock_cpu" -> "sig:cpu_ok";
}
