digraph "register_file_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>register_file</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/memory/register_file/src/register_file.sv; clocks / resets (not drawn): clk, rst_n<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:raddr_i" "in:waddr_i" "in:wdata_i" "in:we_i" }
    "in:raddr_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="raddr_i\n[NRD*$clog2(NREG)-1:0]"];
    "in:waddr_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="waddr_i\n[$clog2(NREG)-1:0]"];
    "in:wdata_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="wdata_i\n[WIDTH-1:0]"];
    "in:we_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="we_i"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:rdata_o" }
    "out:rdata_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="rdata_o\n[NRD*WIDTH-1:0]"];
  }
  subgraph cluster_b0 { label="always_comb @ line 35"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:ra" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="ra\n[AW-1:0]"];
  }
  subgraph cluster_b1 { label="always_ff @ line 31"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:regs" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="regs\n[WIDTH-1:0] x [0:NREG-1]"];
  }
  "in:raddr_i" -> "sig:ra";
  "in:waddr_i" -> "out:rdata_o";
  "in:waddr_i" -> "sig:regs";
  "in:wdata_i" -> "out:rdata_o";
  "in:wdata_i" -> "sig:regs";
  "in:we_i" -> "out:rdata_o";
  "in:we_i" -> "sig:regs";
  "sig:ra" -> "out:rdata_o";
  "sig:regs" -> "out:rdata_o";
}
