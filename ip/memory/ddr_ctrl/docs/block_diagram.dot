digraph "ddr_ctrl" {
  graph [rankdir=LR, bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.65, label="ddr_ctrl RTL hierarchy", labelloc=t, fontname="Helvetica", fontsize=16];
  node [shape=box, fontname="Helvetica", fontsize=10, margin="0.14,0.08"];
  edge [color="#52635c", arrowsize=0.7];
  n0 [label="ddr_ctrl_top\n(top)", style="rounded,filled", fillcolor="#dcefe8", color="#176b59"];
  n1 [label="ddr_ctrl_regs\n(u_regs)", style="rounded,filled", fillcolor="#f4f6f5", color="#71817a"];
  n2 [label="axi4_lite_slave\n(u_axil)", style="rounded,filled", fillcolor="#f4f6f5", color="#71817a"];
  n3 [label="ddr_ctrl\n(u_core)", style="rounded,filled", fillcolor="#f4f6f5", color="#71817a"];
  n4 [label="fallthrough_fifo\n(u_rq)", style="rounded,filled", fillcolor="#f4f6f5", color="#71817a"];
  n5 [label="fallthrough_fifo\n(u_bq)", style="rounded,filled", fillcolor="#f4f6f5", color="#71817a"];
  n0 -> n1;
  n1 -> n2;
  n0 -> n3;
  n3 -> n4;
  n3 -> n5;
}
