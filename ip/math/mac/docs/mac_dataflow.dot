digraph "mac_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>mac</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/math/mac/src/mac.sv; clocks / resets (not drawn): clk, rst_n<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:a_i" "in:acc_i" "in:b_i" "in:valid_i" }
    "in:a_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="a_i\n[A_WIDTH-1:0]"];
    "in:acc_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="acc_i\n[ACC_WIDTH-1:0]"];
    "in:b_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="b_i\n[B_WIDTH-1:0]"];
    "in:valid_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="valid_i"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:inexact_o" "out:invalid_o" "out:overflow_o" "out:result_o" "out:underflow_o" "out:valid_o" }
    "out:inexact_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="inexact_o"];
    "out:invalid_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="invalid_o"];
    "out:overflow_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="overflow_o"];
    "out:result_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="result_o\n[OUT_WIDTH-1:0]"];
    "out:underflow_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="underflow_o"];
    "out:valid_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="valid_o"];
  }
  subgraph cluster_b0 { label="always_comb @ line 101"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:aligned_product" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="aligned_product\n[WORK_WIDTH-1:0]"];
    "sig:fixed_inexact" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="fixed_inexact"];
    "sig:guard_bit" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="guard_bit"];
    "sig:product_quotient" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="product_quotient\n[WORK_WIDTH-1:0]"];
    "sig:round_up" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="round_up"];
    "sig:sticky_bit" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="sticky_bit"];
  }
  subgraph cluster_b1 { label="always_comb @ line 128"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:fixed_overflow" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="fixed_overflow"];
    "sig:fixed_result" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="fixed_result\n[OUT_WIDTH-1:0]"];
    "sig:fixed_sum" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="fixed_sum\n[WORK_WIDTH-1:0]"];
    "sig:signed_max" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="signed_max\n[WORK_WIDTH-1:0]"];
    "sig:signed_min" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="signed_min\n[WORK_WIDTH-1:0]"];
    "sig:unsigned_max" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="unsigned_max\n[WORK_WIDTH-1:0]"];
  }
  subgraph cluster_b2 { label="always_comb @ line 162"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:computed_inexact" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="computed_inexact"];
    "sig:computed_invalid" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="computed_invalid"];
    "sig:computed_overflow" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="computed_overflow"];
    "sig:computed_result" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="computed_result\n[OUT_WIDTH-1:0]"];
    "sig:computed_underflow" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="computed_underflow"];
  }
  subgraph cluster_b3 { label="always_comb @ line 74"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:a_operand" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="a_operand\n[A_WIDTH:0]"];
    "sig:a_product_operand" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="a_product_operand\n[PRODUCT_WIDTH-1:0]"];
    "sig:accumulator_extended" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="accumulator_extended\n[WORK_WIDTH-1:0]"];
    "sig:b_operand" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="b_operand\n[B_WIDTH:0]"];
    "sig:b_product_operand" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="b_product_operand\n[PRODUCT_WIDTH-1:0]"];
    "sig:product_extended" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="product_extended\n[WORK_WIDTH-1:0]"];
    "sig:product_fixed" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="product_fixed\n[PRODUCT_WIDTH-1:0]"];
    "sig:product_magnitude" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="product_magnitude\n[WORK_WIDTH-1:0]"];
  }
  "sig:fp_inexact" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="fp_inexact"];
  "sig:fp_invalid" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="fp_invalid"];
  "sig:fp_overflow" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="fp_overflow"];
  "sig:fp_result" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="fp_result\n[31:0]"];
  "sig:fp_underflow" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="fp_underflow"];
  "const:signed_max" [shape=plaintext, fontcolor="#6b7280", fontsize=8, label="constant"];
  "const:signed_min" [shape=plaintext, fontcolor="#6b7280", fontsize=8, label="constant"];
  "const:unsigned_max" [shape=plaintext, fontcolor="#6b7280", fontsize=8, label="constant"];
  "inst:u_fp32_fma" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>fp32_fma</B><BR/><FONT COLOR="#4b5563">u_fp32_fma</FONT>>];
  "const:signed_max" -> "sig:signed_max";
  "const:signed_min" -> "sig:signed_min";
  "const:unsigned_max" -> "sig:unsigned_max";
  "in:a_i" -> "inst:u_fp32_fma";
  "in:a_i" -> "sig:a_operand";
  "in:acc_i" -> "inst:u_fp32_fma";
  "in:acc_i" -> "sig:accumulator_extended";
  "in:b_i" -> "inst:u_fp32_fma";
  "in:b_i" -> "sig:b_operand";
  "in:valid_i" -> "out:inexact_o";
  "in:valid_i" -> "out:invalid_o";
  "in:valid_i" -> "out:overflow_o";
  "in:valid_i" -> "out:result_o";
  "in:valid_i" -> "out:underflow_o";
  "in:valid_i" -> "out:valid_o";
  "inst:u_fp32_fma" -> "sig:fp_inexact";
  "inst:u_fp32_fma" -> "sig:fp_invalid";
  "inst:u_fp32_fma" -> "sig:fp_overflow";
  "inst:u_fp32_fma" -> "sig:fp_result";
  "inst:u_fp32_fma" -> "sig:fp_underflow";
  "sig:a_operand" -> "sig:a_product_operand";
  "sig:a_product_operand" -> "sig:product_fixed";
  "sig:accumulator_extended" -> "sig:fixed_sum";
  "sig:aligned_product" -> "sig:fixed_sum";
  "sig:b_operand" -> "sig:b_product_operand";
  "sig:b_product_operand" -> "sig:product_fixed";
  "sig:computed_inexact" -> "out:inexact_o";
  "sig:computed_invalid" -> "out:invalid_o";
  "sig:computed_overflow" -> "out:overflow_o";
  "sig:computed_result" -> "out:result_o";
  "sig:computed_underflow" -> "out:underflow_o";
  "sig:fixed_inexact" -> "sig:computed_inexact";
  "sig:fixed_overflow" -> "sig:computed_inexact";
  "sig:fixed_overflow" -> "sig:computed_overflow";
  "sig:fixed_result" -> "sig:computed_result";
  "sig:fixed_sum" -> "sig:fixed_overflow";
  "sig:fixed_sum" -> "sig:fixed_result";
  "sig:fp_inexact" -> "sig:computed_inexact";
  "sig:fp_invalid" -> "sig:computed_invalid";
  "sig:fp_overflow" -> "sig:computed_overflow";
  "sig:fp_result" -> "sig:computed_result";
  "sig:fp_underflow" -> "sig:computed_underflow";
  "sig:guard_bit" -> "sig:fixed_inexact";
  "sig:guard_bit" -> "sig:round_up";
  "sig:product_extended" -> "sig:aligned_product";
  "sig:product_fixed" -> "sig:aligned_product";
  "sig:product_fixed" -> "sig:product_extended";
  "sig:product_fixed" -> "sig:product_magnitude";
  "sig:product_magnitude" -> "sig:guard_bit";
  "sig:product_magnitude" -> "sig:product_quotient";
  "sig:product_magnitude" -> "sig:sticky_bit";
  "sig:product_quotient" -> "sig:aligned_product";
  "sig:product_quotient" -> "sig:product_quotient";
  "sig:product_quotient" -> "sig:round_up";
  "sig:round_up" -> "sig:product_quotient";
  "sig:signed_max" -> "sig:fixed_overflow";
  "sig:signed_max" -> "sig:fixed_result";
  "sig:signed_min" -> "sig:fixed_overflow";
  "sig:signed_min" -> "sig:fixed_result";
  "sig:sticky_bit" -> "sig:fixed_inexact";
  "sig:sticky_bit" -> "sig:round_up";
  "sig:sticky_bit" -> "sig:sticky_bit";
  "sig:unsigned_max" -> "sig:fixed_overflow";
  "sig:unsigned_max" -> "sig:fixed_result";
}
