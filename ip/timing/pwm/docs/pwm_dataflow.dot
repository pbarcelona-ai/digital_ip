  "sig:hi" -> "out:pwm_o";
  "sig:lo" -> "out:pwm_n_o";
  "sig:pcnt" -> "sig:pcnt";
  "sig:pcnt" -> "sig:tick";
  "sig:period" -> "sig:boundary";
  "sig:period" -> "sig:cnt";
  "sig:period" -> "sig:dir_dn";
  "sig:presc" -> "sig:pcnt";
