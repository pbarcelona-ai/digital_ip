digraph "baud_nco" {
  graph [rankdir=LR, bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.65, label="baud_nco RTL hierarchy", labelloc=t, fontname="Helvetica", fontsize=16];
  node [shape=box, fontname="Helvetica", fontsize=10, margin="0.14,0.08"];
  edge [color="#52635c", arrowsize=0.7];
  n0 [label="baud_nco_top\n(top)", style="rounded,filled", fillcolor="#dcefe8", color="#176b59"];
  n1 [label="ip_axil_regs\n(u_regs)", style="rounded,filled", fillcolor="#f4f6f5", color="#71817a"];
  n2 [label="nco_core\n(u_core)", style="rounded,filled", fillcolor="#f4f6f5", color="#71817a"];
  n3 [label="nco_sine_rom\n(u_rom)", style="rounded,filled", fillcolor="#f4f6f5", color="#71817a"];
  n0 -> n1;
  n0 -> n2;
  n2 -> n3;
}
