  "sig:cnt" -> "sig:cnt";
  "sig:cnt" -> "sig:expire_now";
  "sig:cnt" -> "sig:kick_early";
  "sig:cnt" -> "sig:pre_f";
  "sig:cnt" -> "sig:rd";
  "sig:early_f" -> "sig:rd";
  "sig:en_q" -> "out:wdt_reset_o";
