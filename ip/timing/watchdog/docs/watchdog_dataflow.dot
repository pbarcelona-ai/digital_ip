digraph "watchdog_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>watchdog_top</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/timing/watchdog/src/watchdog_top.sv; clocks / resets (not drawn): aclk, aresetn<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:s_axil_*" }
    "in:s_axil_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="s_axil_*\ns_axil_awaddr\ns_axil_awvalid\ns_axil_wdata\ns_axil_wstrb\ns_axil_wvalid\ns_axil_bready\ns_axil_araddr\ns_axil_arvalid\ns_axil_rready"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:irq_o" "out:s_axil_*" "out:wdt_reset_o" }
    "out:irq_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="irq_o"];
    "out:s_axil_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="s_axil_*\ns_axil_awready\ns_axil_wready\ns_axil_bresp\ns_axil_bvalid\ns_axil_arready\ns_axil_rdata\ns_axil_rresp\ns_axil_rvalid"];
    "out:wdt_reset_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="wdt_reset_o"];
  }
  subgraph cluster_b0 { label="always @ line 52"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:ip_chk_b_q" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="ip_chk_b_q"];
    "sig:ip_chk_r_q" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="ip_chk_r_q"];
  }
  subgraph cluster_b1 { label="always_ff @ line 105"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:cnt" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="cnt\n[31:0]"];
    "sig:early_f" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="early_f"];
    "sig:exp_f" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="exp_f"];
    "sig:key_f" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="key_f"];
    "sig:pre_f" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="pre_f"];
    "sig:rst_cnt" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="rst_cnt\n[7:0]"];
  }
  subgraph cluster_b2 { label="always_ff @ line 78"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:en_q" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="en_q"];
    "sig:lock_q" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="lock_q"];
  }
  subgraph cluster_b3 { label="always_ff @ line 88"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:pcnt" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="pcnt\n[31:0]"];
    "sig:tick" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="tick"];
  }
  "sig:expire_now" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="expire_now"];
  "sig:kick_bad" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="kick_bad"];
  "sig:kick_early" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="kick_early"];
  "sig:kick_good" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="kick_good"];
  "sig:kick_ok" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="kick_ok"];
  "sig:kick_wr" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="kick_wr"];
  "sig:presc" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="presc\n[31:0]"];
  "sig:pretmo" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="pretmo\n[31:0]"];
  "sig:rd" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="rd\n[8*32-1:0]"];
  "sig:regs" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="regs\n[8*32-1:0]"];
  "sig:timeout" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="timeout\n[31:0]"];
  "sig:win_en" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="win_en"];
  "sig:win_open" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="win_open\n[31:0]"];
  "sig:wr_data" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="wr_data\n[31:0]"];
  "sig:wr_pulse" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="wr_pulse\n[7:0]"];
  "inst:u_regs" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>ip_axil_regs</B><BR/><FONT COLOR="#4b5563">u_regs</FONT>>];
  "in:s_axil_*" -> "sig:ip_chk_b_q";
  "in:s_axil_*" -> "sig:ip_chk_r_q";
  "inst:u_regs" -> "out:s_axil_*";
