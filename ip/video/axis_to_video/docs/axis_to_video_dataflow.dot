  "sig:level" -> "out:src_ready_o";
  "sig:n_bar" -> "sig:bar";
  "sig:n_bar" -> "sig:bar_rgb";
  "sig:n_cnt" -> "sig:bar_cnt";
  "sig:next" -> "sig:n_bar";
  "sig:next" -> "sig:n_cnt";
  "sig:starve" -> "out:locked_o";
  "sig:starve" -> "out:underflow_o";
  "sig:starve" -> "sig:synced";
  "sig:synced" -> "sig:discard";
  "sig:synced" -> "sig:starve";
  "sig:synced" -> "sig:take";
  "sig:take" -> "out:rgb_o";
  "sig:take" -> "sig:f_ready";
  "in:s_axis_*" -> "inst:u_fifo" [penwidth=3.2, color="#0f766e", fontcolor="#0f766e", fontname="Courier", fontsize=9, label="AXI4-Stream
s_axis_t* (5)"];
