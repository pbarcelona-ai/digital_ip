digraph "axis_to_video_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>axis_to_video</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/video/axis_to_video/src/axis_to_video.sv; clocks / resets (not drawn): clk, rst_n<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:de_i" "in:h_active_i" "in:hs_i" "in:s_axis_*" "in:sof_i" "in:start_level_i" "in:tpg_en_i" "in:vblank_i" "in:vs_i" }
    "in:de_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="de_i"];
    "in:h_active_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="h_active_i\n[15:0]"];
    "in:hs_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="hs_i"];
    "in:s_axis_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="s_axis_*\ns_axis_tdata\ns_axis_tlast\ns_axis_tuser\ns_axis_tvalid"];
    "in:sof_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="sof_i"];
    "in:start_level_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="start_level_i\n[15:0]"];
    "in:tpg_en_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="tpg_en_i"];
    "in:vblank_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="vblank_i"];
    "in:vs_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="vs_i"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:de_o" "out:hs_o" "out:locked_o" "out:rgb_o" "out:src_ready_o" "out:underflow_o" "out:vs_o" }
    "out:de_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="de_o"];
    "out:hs_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="hs_o"];
    "out:locked_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="locked_o"];
    "out:rgb_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="rgb_o\n[PIX_W-1:0]"];
    "out:src_ready_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="src_ready_o"];
    "out:underflow_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="underflow_o"];
    "out:vs_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="vs_o"];
  }
  subgraph cluster_b0 { label="always_comb @ line 84"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:bar_rgb" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="bar_rgb\n[23:0]"];
  }
  subgraph cluster_b1 { label="always_ff @ line 89"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:bar" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="bar\n[2:0]"];
    "sig:bar_cnt" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="bar_cnt\n[15:0]"];
    "sig:de_q" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="de_q"];
    "sig:synced" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="synced"];
  }
  "sig:bar_w" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="bar_w\n[15:0]"];
  "sig:discard" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="discard"];
  "sig:f_data" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="f_data\n[PIX_W-1:0]"];
  "sig:f_last" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="f_last"];
  "sig:f_ready" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="f_ready"];
  "sig:f_user" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="f_user"];
  "sig:f_valid" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="f_valid"];
  "sig:first" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="first"];
  "sig:head_sof" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="head_sof"];
  "sig:level" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="level\n[LW-1:0]"];
  "sig:n_bar" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="n_bar\n[2:0]"];
  "sig:n_cnt" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="n_cnt\n[15:0]"];
  "sig:next" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="next"];
  "sig:start_ok" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="start_ok"];
  "sig:starve" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="starve"];
  "sig:take" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="take"];
  "inst:u_fifo" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>ip_axis_fifo</B><BR/><FONT COLOR="#4b5563">u_fifo</FONT>>];
  "in:de_i" -> "out:de_o";
  "in:de_i" -> "out:locked_o";
  "in:de_i" -> "out:rgb_o";
  "in:de_i" -> "out:underflow_o";
  "in:de_i" -> "sig:bar";
  "in:de_i" -> "sig:bar_cnt";
  "in:de_i" -> "sig:de_q";
  "in:de_i" -> "sig:discard";
  "in:de_i" -> "sig:first";
  "in:de_i" -> "sig:start_ok";
  "in:de_i" -> "sig:starve";
  "in:de_i" -> "sig:synced";
  "in:de_i" -> "sig:take";
  "in:h_active_i" -> "sig:bar_w";
  "in:hs_i" -> "out:hs_o";
  "in:sof_i" -> "out:locked_o";
  "in:sof_i" -> "out:underflow_o";
  "in:sof_i" -> "sig:discard";
  "in:sof_i" -> "sig:start_ok";
  "in:sof_i" -> "sig:starve";
  "in:sof_i" -> "sig:synced";
  "in:sof_i" -> "sig:take";
  "in:start_level_i" -> "out:src_ready_o";
  "in:tpg_en_i" -> "out:locked_o";
  "in:tpg_en_i" -> "out:rgb_o";
  "in:tpg_en_i" -> "out:underflow_o";
  "in:tpg_en_i" -> "sig:discard";
  "in:tpg_en_i" -> "sig:starve";
  "in:tpg_en_i" -> "sig:synced";
  "in:tpg_en_i" -> "sig:take";
  "in:vblank_i" -> "sig:synced";
  "in:vs_i" -> "out:vs_o";
  "inst:u_fifo" -> "sig:f_data";
  "inst:u_fifo" -> "sig:f_last";
  "inst:u_fifo" -> "sig:f_user";
  "inst:u_fifo" -> "sig:f_valid";
  "inst:u_fifo" -> "sig:level";
  "out:locked_o" -> "out:locked_o";
  "out:locked_o" -> "out:underflow_o";
  "sig:bar" -> "sig:n_bar";
  "sig:bar" -> "sig:next";
  "sig:bar_cnt" -> "sig:n_cnt";
  "sig:bar_cnt" -> "sig:next";
  "sig:bar_rgb" -> "out:rgb_o";
  "sig:bar_w" -> "sig:next";
  "sig:de_q" -> "sig:first";
  "sig:discard" -> "sig:f_ready";
  "sig:f_data" -> "out:rgb_o";
  "sig:f_ready" -> "inst:u_fifo";
  "sig:f_user" -> "sig:discard";
  "sig:f_user" -> "sig:head_sof";
  "sig:f_user" -> "sig:starve";
  "sig:f_user" -> "sig:take";
  "sig:f_valid" -> "sig:discard";
  "sig:f_valid" -> "sig:head_sof";
  "sig:f_valid" -> "sig:starve";
  "sig:f_valid" -> "sig:take";
  "sig:first" -> "sig:n_bar";
  "sig:first" -> "sig:n_cnt";
  "sig:first" -> "sig:next";
  "sig:head_sof" -> "out:locked_o";
  "sig:head_sof" -> "out:src_ready_o";
  "sig:head_sof" -> "out:underflow_o";
  "sig:head_sof" -> "sig:start_ok";
  "sig:head_sof" -> "sig:synced";
