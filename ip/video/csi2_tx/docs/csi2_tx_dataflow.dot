    "out:underflow_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="underflow_o"];
  }
  subgraph cluster_b0 { label="always_comb @ line 103"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:cmd" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="cmd\n[45:0]"];
    "sig:cmd_v" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="cmd_v"];
