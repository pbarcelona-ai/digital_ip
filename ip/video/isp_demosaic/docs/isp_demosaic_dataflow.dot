digraph "isp_demosaic_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>isp_demosaic</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/video/isp_demosaic/src/isp_demosaic.sv; clocks / resets (not drawn): clk, rst_n<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:bypass_i" "in:cfa_i" "in:height_i" "in:m_axis_*" "in:s_axis_*" "in:width_i" }
    "in:bypass_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="bypass_i"];
    "in:cfa_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="cfa_i\n[1:0]"];
    "in:height_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="height_i\n[15:0]"];
    "in:m_axis_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="m_axis_tready"];
    "in:s_axis_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="s_axis_*\ns_axis_tdata\ns_axis_tlast\ns_axis_tuser\ns_axis_tvalid"];
    "in:width_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="width_i\n[15:0]"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:m_axis_*" }
    "out:m_axis_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="m_axis_*\nm_axis_tdata\nm_axis_tlast\nm_axis_tuser\nm_axis_tvalid"];
  }
  subgraph cluster_b0 { label="always_comb @ line 60"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:b" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="b\n[PW-1:0]"];
    "sig:g" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="g\n[PW-1:0]"];
    "sig:r" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="r\n[PW-1:0]"];
  }
  subgraph cluster_b1 { label="always_ff @ line 71"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:by_f" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="by_f"];
    "sig:cfa_f" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="cfa_f\n[1:0]"];
  }
  "sig:by" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="by"];
  "sig:c" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="c\n[PW-1:0]"];
  "sig:cfa" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="cfa\n[1:0]"];
  "sig:color" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="color\n[1:0]"];
  "sig:crs" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="crs\n[PW+1:0]"];
  "sig:d4" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="d4\n[PW-1:0]"];
  "sig:diag" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="diag\n[PW+1:0]"];
  "sig:e" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="e\n[PW-1:0]"];
  "sig:g4" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="g4\n[PW-1:0]"];
  "sig:h2" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="h2\n[PW-1:0]"];
  "sig:hor" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="hor\n[PW:0]"];
  "sig:n" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="n\n[PW-1:0]"];
  "sig:ne" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="ne\n[PW-1:0]"];
  "sig:nw" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="nw\n[PW-1:0]"];
  "sig:s" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="s\n[PW-1:0]"];
  "sig:se" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="se\n[PW-1:0]"];
  "sig:sw" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="sw\n[PW-1:0]"];
  "sig:v2" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="v2\n[PW-1:0]"];
  "sig:ver" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="ver\n[PW:0]"];
  "sig:w" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="w\n[PW-1:0]"];
  "sig:win" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="win\n[9*PW-1:0]"];
  "sig:wl" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="wl"];
  "sig:wr" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="wr"];
  "sig:wu" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="wu"];
  "sig:wv" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="wv"];
  "sig:wx" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="wx\n[15:0]"];
  "sig:wy" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="wy\n[15:0]"];
  "inst:u_win" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>isp_window</B><BR/><FONT COLOR="#4b5563">u_win</FONT>>];
  "in:bypass_i" -> "sig:by";
  "in:bypass_i" -> "sig:by_f";
  "in:cfa_i" -> "sig:cfa";
  "in:cfa_i" -> "sig:cfa_f";
  "in:height_i" -> "inst:u_win";
  "in:m_axis_*" -> "out:m_axis_*";
  "in:m_axis_*" -> "sig:wr";
  "in:width_i" -> "inst:u_win";
  "inst:u_win" -> "sig:win";
  "inst:u_win" -> "sig:wl";
  "inst:u_win" -> "sig:wu";
  "inst:u_win" -> "sig:wv";
  "inst:u_win" -> "sig:wx";
  "inst:u_win" -> "sig:wy";
  "out:m_axis_*" -> "sig:wr";
  "sig:b" -> "out:m_axis_*";
  "sig:by" -> "sig:b";
  "sig:by" -> "sig:g";
  "sig:by" -> "sig:r";
  "sig:by_f" -> "sig:by";
  "sig:c" -> "sig:b";
  "sig:c" -> "sig:g";
  "sig:c" -> "sig:r";
  "sig:cfa" -> "sig:color";
  "sig:cfa_f" -> "sig:cfa";
  "sig:color" -> "sig:b";
  "sig:color" -> "sig:g";
  "sig:color" -> "sig:r";
  "sig:crs" -> "sig:g4";
  "sig:d4" -> "sig:b";
  "sig:d4" -> "sig:r";
  "sig:diag" -> "sig:d4";
  "sig:e" -> "sig:crs";
  "sig:e" -> "sig:hor";
  "sig:g" -> "out:m_axis_*";
  "sig:g4" -> "sig:g";
  "sig:h2" -> "sig:b";
  "sig:h2" -> "sig:r";
  "sig:hor" -> "sig:h2";
  "sig:n" -> "sig:crs";
  "sig:n" -> "sig:ver";
  "sig:ne" -> "sig:diag";
  "sig:nw" -> "sig:diag";
  "sig:r" -> "out:m_axis_*";
  "sig:s" -> "sig:crs";
  "sig:s" -> "sig:ver";
  "sig:se" -> "sig:diag";
  "sig:sw" -> "sig:diag";
  "sig:v2" -> "sig:b";
  "sig:v2" -> "sig:r";
  "sig:ver" -> "sig:v2";
  "sig:w" -> "sig:crs";
  "sig:w" -> "sig:hor";
  "sig:win" -> "sig:c";
  "sig:win" -> "sig:e";
  "sig:win" -> "sig:n";
  "sig:win" -> "sig:ne";
  "sig:win" -> "sig:nw";
  "sig:win" -> "sig:s";
  "sig:win" -> "sig:se";
  "sig:win" -> "sig:sw";
  "sig:win" -> "sig:w";
  "sig:wl" -> "out:m_axis_*";
  "sig:wr" -> "inst:u_win";
  "sig:wr" -> "out:m_axis_*";
  "sig:wr" -> "sig:by_f";
  "sig:wr" -> "sig:cfa_f";
  "sig:wu" -> "out:m_axis_*";
  "sig:wu" -> "sig:by";
  "sig:wu" -> "sig:by_f";
  "sig:wu" -> "sig:cfa";
  "sig:wu" -> "sig:cfa_f";
  "sig:wv" -> "out:m_axis_*";
  "sig:wv" -> "sig:by_f";
  "sig:wv" -> "sig:cfa_f";
  "sig:wx" -> "sig:color";
  "sig:wy" -> "sig:color";
  "in:s_axis_*" -> "inst:u_win" [penwidth=3.2, color="#0f766e", fontcolor="#0f766e", fontname="Courier", fontsize=9, label="AXI4-Stream
s_axis_t* (5)"];
}
