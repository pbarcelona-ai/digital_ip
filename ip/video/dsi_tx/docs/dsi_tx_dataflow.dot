digraph "dsi_tx_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>dsi_tx</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/video/dsi_tx/src/dsi_tx.sv; clocks / resets (not drawn): bclk, pclk<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:brst_n" "in:cmd_byte_i" "in:cmd_byte_wr_i" "in:cmd_i" "in:cmd_wr_i" "in:de_i" "in:eotp_i" "in:hs_i" "in:hs_pol_i" "in:line_gap_i" "in:prst_n" "in:rgb_i" "in:sync_gap_i" "in:tx_ready_i" "in:vc_i" "in:video_en_i" "in:vs_i" "in:vs_pol_i" }
    "in:brst_n" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="brst_n"];
    "in:cmd_byte_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="cmd_byte_i\n[7:0]"];
