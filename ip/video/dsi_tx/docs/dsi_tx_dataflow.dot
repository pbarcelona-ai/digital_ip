    "in:rgb_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="rgb_i\n[23:0]"];
    "in:sync_gap_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="sync_gap_i\n[15:0]"];
