digraph "vs_stream_adapter_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>vs_stream_adapter</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/video/vs_stream_adapter/src/vs_stream_adapter.sv; clocks / resets (not drawn): clk, rst_n<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:m_axis_*" "in:r_s_axis_*" "in:s_axis_*" }
    "in:m_axis_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="m_axis_tready"];
    "in:r_s_axis_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="r_s_axis_*\nr_s_axis_tdata\nr_s_axis_tlast\nr_s_axis_tuser\nr_s_axis_tvalid"];
    "in:s_axis_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="s_axis_*\ns_axis_tdata\ns_axis_tlast\ns_axis_tuser\ns_axis_tvalid"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:drops_o" "out:frames_o" "out:m_axis_*" "out:r_m_axis_*" "out:r_s_axis_*" "out:ret_drops_o" "out:s_axis_*" }
    "out:drops_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="drops_o\n[31:0]"];
    "out:frames_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="frames_o\n[31:0]"];
    "out:m_axis_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="m_axis_*\nm_axis_tdata\nm_axis_tlast\nm_axis_tuser\nm_axis_tvalid"];
    "out:r_m_axis_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="r_m_axis_*\nr_m_axis_tdata\nr_m_axis_tlast\nr_m_axis_tuser\nr_m_axis_tvalid"];
    "out:r_s_axis_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="r_s_axis_tready"];
    "out:ret_drops_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="ret_drops_o\n[31:0]"];
    "out:s_axis_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="s_axis_tready"];
  }
  subgraph cluster_b0 { label="always_ff @ line 109"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:gap" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="gap\n[$clog2(GAP+1)-1:0]"];
    "sig:st" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="st"];
  }
  "sig:fwd" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="fwd"];
  "sig:ret_empty" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="ret_empty"];
  "sig:rf_level" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="rf_level\n[$clog2(RET_FIFO)+1:0]"];
  "sig:rf_ready" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="rf_ready"];
  "sig:sof" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="sof"];
  "sig:take" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="take"];
  "const:r_s_axis_tready" [shape=plaintext, fontcolor="#6b7280", fontsize=8, label="constant"];
  "inst:u_ret_fifo" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>ip_axis_fifo</B><BR/><FONT COLOR="#4b5563">u_ret_fifo</FONT>>];
  "const:r_s_axis_tready" -> "out:r_s_axis_*";
  "in:m_axis_*" -> "out:s_axis_*";
  "in:m_axis_*" -> "sig:take";
  "in:r_s_axis_*" -> "out:ret_drops_o";
  "in:r_s_axis_*" -> "sig:ret_empty";
  "in:s_axis_*" -> "out:drops_o";
  "in:s_axis_*" -> "out:frames_o";
  "in:s_axis_*" -> "out:m_axis_*";
  "in:s_axis_*" -> "sig:gap";
  "in:s_axis_*" -> "sig:sof";
  "in:s_axis_*" -> "sig:st";
  "inst:u_ret_fifo" -> "sig:rf_level";
  "inst:u_ret_fifo" -> "sig:rf_ready";
  "out:drops_o" -> "out:drops_o";
  "out:frames_o" -> "out:frames_o";
  "out:ret_drops_o" -> "out:ret_drops_o";
  "out:s_axis_*" -> "out:drops_o";
  "out:s_axis_*" -> "out:frames_o";
  "out:s_axis_*" -> "sig:gap";
  "out:s_axis_*" -> "sig:st";
  "sig:fwd" -> "out:drops_o";
  "sig:fwd" -> "out:frames_o";
  "sig:fwd" -> "out:m_axis_*";
  "sig:fwd" -> "out:s_axis_*";
  "sig:fwd" -> "sig:gap";
  "sig:fwd" -> "sig:st";
  "sig:gap" -> "sig:gap";
  "sig:gap" -> "sig:st";
  "sig:ret_empty" -> "sig:take";
  "sig:rf_level" -> "sig:ret_empty";
  "sig:rf_ready" -> "out:ret_drops_o";
  "sig:sof" -> "out:drops_o";
  "sig:sof" -> "out:frames_o";
  "sig:sof" -> "sig:st";
  "sig:sof" -> "sig:take";
  "sig:st" -> "out:drops_o";
  "sig:st" -> "out:frames_o";
  "sig:st" -> "out:s_axis_*";
  "sig:st" -> "sig:fwd";
  "sig:st" -> "sig:gap";
  "sig:st" -> "sig:st";
  "sig:st" -> "sig:take";
  "sig:take" -> "sig:fwd";
  "inst:u_ret_fifo" -> "out:r_m_axis_*" [penwidth=3.2, color="#0f766e", fontcolor="#0f766e", fontname="Courier", fontsize=9, label="AXI4-Stream
r_m_axis_t* (5)"];
  "in:r_s_axis_*" -> "inst:u_ret_fifo" [penwidth=3.2, color="#0f766e", fontcolor="#0f766e", fontname="Courier", fontsize=9, label="AXI4-Stream
r_s_axis_t* (4)"];
}
