digraph "isp_dpc_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>isp_dpc</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/video/isp_dpc/src/isp_dpc.sv; clocks / resets (not drawn): clk, rst_n<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:bypass_i" "in:height_i" "in:m_axis_*" "in:s_axis_*" "in:thr_i" "in:width_i" }
    "in:bypass_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="bypass_i"];
    "in:height_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="height_i\n[15:0]"];
    "in:m_axis_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="m_axis_tready"];
    "in:s_axis_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="s_axis_*\ns_axis_tdata\ns_axis_tlast\ns_axis_tuser\ns_axis_tvalid"];
    "in:thr_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="thr_i\n[PW-1:0]"];
    "in:width_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="width_i\n[15:0]"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:corrected_o" "out:m_axis_*" }
    "out:corrected_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="corrected_o"];
    "out:m_axis_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="m_axis_*\nm_axis_tdata\nm_axis_tlast\nm_axis_tuser\nm_axis_tvalid"];
  }
  subgraph cluster_b0 { label="always_comb @ line 54"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:c" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="c\n[PW-1:0]"];
    "sig:mn" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="mn\n[PW-1:0]"];
    "sig:mx" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="mx\n[PW-1:0]"];
  }
  subgraph cluster_b1 { label="always_ff @ line 68"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:by_f" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="by_f"];
  }
  "sig:by" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="by"];
  "sig:dead" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="dead"];
  "sig:hot" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="hot"];
  "sig:win" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="win\n[25*PW-1:0]"];
  "sig:wl" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="wl"];
  "sig:wr" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="wr"];
  "sig:wu" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="wu"];
  "sig:wv" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="wv"];
  "sig:wx" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="wx\n[15:0]"];
  "sig:wy" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="wy\n[15:0]"];
  "const:c" [shape=plaintext, fontcolor="#6b7280", fontsize=8, label="constant"];
  "inst:u_win" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>isp_window</B><BR/><FONT COLOR="#4b5563">u_win</FONT>>];
  "const:c" -> "sig:c";
  "in:bypass_i" -> "sig:by";
  "in:bypass_i" -> "sig:by_f";
  "in:height_i" -> "inst:u_win";
  "in:m_axis_*" -> "out:m_axis_*";
  "in:m_axis_*" -> "sig:wr";
  "in:thr_i" -> "sig:dead";
  "in:thr_i" -> "sig:hot";
  "in:width_i" -> "inst:u_win";
  "inst:u_win" -> "sig:win";
  "inst:u_win" -> "sig:wl";
  "inst:u_win" -> "sig:wu";
  "inst:u_win" -> "sig:wv";
  "inst:u_win" -> "sig:wx";
  "inst:u_win" -> "sig:wy";
  "out:m_axis_*" -> "sig:wr";
  "sig:by" -> "out:corrected_o";
  "sig:by" -> "out:m_axis_*";
  "sig:by_f" -> "sig:by";
  "sig:c" -> "out:m_axis_*";
  "sig:c" -> "sig:dead";
  "sig:c" -> "sig:hot";
  "sig:dead" -> "out:corrected_o";
  "sig:dead" -> "out:m_axis_*";
  "sig:hot" -> "out:corrected_o";
  "sig:hot" -> "out:m_axis_*";
  "sig:mn" -> "out:m_axis_*";
  "sig:mn" -> "sig:dead";
  "sig:mn" -> "sig:mn";
  "sig:mx" -> "out:m_axis_*";
  "sig:mx" -> "sig:hot";
  "sig:mx" -> "sig:mx";
  "sig:wl" -> "out:m_axis_*";
  "sig:wr" -> "inst:u_win";
  "sig:wr" -> "out:corrected_o";
  "sig:wr" -> "out:m_axis_*";
  "sig:wr" -> "sig:by_f";
  "sig:wu" -> "out:m_axis_*";
  "sig:wu" -> "sig:by";
  "sig:wu" -> "sig:by_f";
  "sig:wv" -> "out:corrected_o";
  "sig:wv" -> "out:m_axis_*";
  "sig:wv" -> "sig:by_f";
  "in:s_axis_*" -> "inst:u_win" [penwidth=3.2, color="#0f766e", fontcolor="#0f766e", fontname="Courier", fontsize=9, label="AXI4-Stream
s_axis_t* (5)"];
}
