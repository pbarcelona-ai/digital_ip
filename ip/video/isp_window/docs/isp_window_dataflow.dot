digraph "isp_window_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>isp_window</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/video/isp_window/src/isp_window.sv; clocks / resets (not drawn): clk, rst_n<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:height_i" "in:m_axis_*" "in:s_axis_*" "in:width_i" }
    "in:height_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="height_i\n[15:0]"];
    "in:m_axis_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="m_axis_tready"];
    "in:s_axis_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="s_axis_*\ns_axis_tdata\ns_axis_tlast\ns_axis_tuser\ns_axis_tvalid"];
    "in:width_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="width_i\n[15:0]"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:m_axis_*" "out:m_x" "out:m_y" "out:s_axis_*" "out:sof_wait_o" }
    "out:m_axis_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="m_axis_*\nm_axis_tdata\nm_axis_tlast\nm_axis_tuser\nm_axis_tvalid"];
    "out:m_x" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="m_x\n[15:0]"];
    "out:m_y" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="m_y\n[15:0]"];
    "out:s_axis_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="s_axis_tready"];
    "out:sof_wait_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="sof_wait_o"];
  }
  subgraph cluster_b0 { label="always_comb @ line 126"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:win" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="win\n[N*N*PW-1:0]"];
  }
  subgraph cluster_b1 { label="always_comb @ line 99"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:col" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="col\n[PW-1:0] x [N]"];
    "sig:raw" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="raw\n[PW-1:0] x [N]"];
  }
  subgraph cluster_b2 { label="always_ff @ line 138"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:cstore" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="cstore\n[PW-1:0] x [N][N]"];
    "sig:x" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="x\n[15:0]"];
    "sig:y" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="y\n[15:0]"];
  }
  subgraph cluster_b3 { label="always_ff @ line 86"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:mem" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="mem\n[PW-1:0] x [MAX_W]"];
    "sig:q" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="q\n[PW-1:0] x [N-1]"];
  }
  "sig:advance" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="advance"];
  "sig:at_sof" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="at_sof"];
  "sig:drop" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="drop"];
  "sig:need_in" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="need_in"];
  "sig:nx" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="nx\n[15:0]"];
  "sig:ny" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="ny\n[15:0]"];
  "sig:o_free" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="o_free"];
  "sig:prod" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="prod"];
  "sig:raddr" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="raddr\n[AW-1:0]"];
  "sig:raddr16" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="raddr16\n[15:0]"];
  "sig:restart" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="restart"];
  "sig:wr_en" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="wr_en"];
  "sig:xend" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="xend\n[15:0]"];
  "sig:yend" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="yend\n[15:0]"];
  "in:height_i" -> "sig:need_in";
  "in:height_i" -> "sig:raw";
  "in:height_i" -> "sig:yend";
  "in:m_axis_*" -> "out:m_axis_*";
  "in:m_axis_*" -> "sig:o_free";
  "in:s_axis_*" -> "sig:advance";
  "in:s_axis_*" -> "sig:drop";
