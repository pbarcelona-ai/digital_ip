  "sig:prod" -> "out:m_axis_*";
  "sig:prod" -> "out:m_x";
  "sig:prod" -> "out:m_y";
  "sig:prod" -> "out:s_axis_*";
  "sig:prod" -> "sig:advance";
  "sig:q" -> "sig:raw";
