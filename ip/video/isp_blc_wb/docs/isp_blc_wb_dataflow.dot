digraph "isp_blc_wb_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>isp_blc_wb</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/video/isp_blc_wb/src/isp_blc_wb.sv; clocks / resets (not drawn): clk, rst_n<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:blc_bypass_i" "in:blc_i" "in:cfa_i" "in:gain_b_i" "in:gain_g_i" "in:gain_r_i" "in:m_axis_*" "in:s_axis_*" "in:wb_bypass_i" }
    "in:blc_bypass_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="blc_bypass_i"];
    "in:blc_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="blc_i\n[4*PW-1:0]"];
    "in:cfa_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="cfa_i\n[1:0]"];
    "in:gain_b_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="gain_b_i\n[11:0]"];
    "in:gain_g_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="gain_g_i\n[11:0]"];
    "in:gain_r_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="gain_r_i\n[11:0]"];
    "in:m_axis_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="m_axis_tready"];
    "in:s_axis_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="s_axis_*\ns_axis_tdata\ns_axis_tlast\ns_axis_tuser\ns_axis_tvalid"];
    "in:wb_bypass_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="wb_bypass_i"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:m_axis_*" "out:s_axis_*" }
    "out:m_axis_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="m_axis_*\nm_axis_tdata\nm_axis_tlast\nm_axis_tuser\nm_axis_tvalid"];
    "out:s_axis_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="s_axis_tready"];
  }
  subgraph cluster_b0 { label="always_ff @ line 65"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:blc_by_f" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="blc_by_f"];
    "sig:c1" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="c1\n[1:0]"];
    "sig:cfa_f" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="cfa_f\n[1:0]"];
    "sig:l1" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="l1"];
    "sig:u1" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="u1"];
    "sig:v1" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="v1\n[PW-1:0]"];
    "sig:val1" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="val1"];
    "sig:wb1" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="wb1"];
    "sig:wb_by_f" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="wb_by_f"];
    "sig:xo" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="xo"];
    "sig:yo" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="yo"];
  }
  "sig:acc" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="acc"];
  "sig:blc_by" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="blc_by"];
  "sig:cfa_now" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="cfa_now\n[1:0]"];
  "sig:color" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="color\n[1:0]"];
  "sig:en" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="en"];
  "sig:g" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="g\n[11:0]"];
  "sig:prod" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="prod\n[PW+12:0]"];
  "sig:px_x" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="px_x"];
  "sig:px_y" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="px_y"];
  "sig:scaled" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="scaled\n[PW-1:0] x [PW-1:0]"];
  "sig:wb_by" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="wb_by"];
  "sig:wb_out" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="wb_out\n[PW-1:0]"];
  "in:blc_bypass_i" -> "sig:blc_by";
  "in:blc_bypass_i" -> "sig:blc_by_f";
  "in:blc_i" -> "sig:v1";
  "in:cfa_i" -> "sig:cfa_f";
  "in:cfa_i" -> "sig:cfa_now";
  "in:gain_b_i" -> "sig:g";
  "in:gain_g_i" -> "sig:g";
  "in:gain_r_i" -> "sig:g";
  "in:m_axis_*" -> "sig:en";
  "in:s_axis_*" -> "sig:acc";
  "in:s_axis_*" -> "sig:blc_by";
  "in:s_axis_*" -> "sig:blc_by_f";
  "in:s_axis_*" -> "sig:cfa_f";
  "in:s_axis_*" -> "sig:cfa_now";
  "in:s_axis_*" -> "sig:l1";
  "in:s_axis_*" -> "sig:px_x";
  "in:s_axis_*" -> "sig:px_y";
  "in:s_axis_*" -> "sig:u1";
  "in:s_axis_*" -> "sig:v1";
  "in:s_axis_*" -> "sig:wb_by";
  "in:s_axis_*" -> "sig:wb_by_f";
  "in:s_axis_*" -> "sig:xo";
  "in:s_axis_*" -> "sig:yo";
  "in:wb_bypass_i" -> "sig:wb_by";
  "in:wb_bypass_i" -> "sig:wb_by_f";
  "out:m_axis_*" -> "sig:en";
  "sig:acc" -> "sig:blc_by_f";
  "sig:acc" -> "sig:cfa_f";
  "sig:acc" -> "sig:val1";
  "sig:acc" -> "sig:wb_by_f";
  "sig:acc" -> "sig:xo";
  "sig:acc" -> "sig:yo";
  "sig:blc_by" -> "sig:v1";
  "sig:blc_by_f" -> "sig:blc_by";
  "sig:c1" -> "sig:g";
  "sig:cfa_f" -> "sig:cfa_now";
  "sig:cfa_now" -> "sig:color";
  "sig:color" -> "sig:c1";
  "sig:color" -> "sig:v1";
  "sig:en" -> "out:m_axis_*";
  "sig:en" -> "out:s_axis_*";
  "sig:en" -> "sig:acc";
  "sig:en" -> "sig:blc_by_f";
  "sig:en" -> "sig:c1";
  "sig:en" -> "sig:cfa_f";
  "sig:en" -> "sig:l1";
  "sig:en" -> "sig:u1";
  "sig:en" -> "sig:v1";
  "sig:en" -> "sig:val1";
  "sig:en" -> "sig:wb1";
  "sig:en" -> "sig:wb_by_f";
  "sig:en" -> "sig:xo";
  "sig:en" -> "sig:yo";
  "sig:g" -> "sig:prod";
  "sig:l1" -> "out:m_axis_*";
  "sig:prod" -> "sig:scaled";
  "sig:px_x" -> "sig:color";
  "sig:px_x" -> "sig:xo";
  "sig:px_y" -> "sig:color";
  "sig:px_y" -> "sig:yo";
  "sig:scaled" -> "sig:wb_out";
  "sig:u1" -> "out:m_axis_*";
  "sig:v1" -> "out:m_axis_*";
  "sig:v1" -> "sig:prod";
  "sig:val1" -> "out:m_axis_*";
  "sig:wb1" -> "out:m_axis_*";
  "sig:wb_by" -> "sig:wb1";
  "sig:wb_by_f" -> "sig:wb_by";
  "sig:wb_out" -> "out:m_axis_*";
  "sig:xo" -> "sig:px_x";
  "sig:yo" -> "sig:px_y";
}
