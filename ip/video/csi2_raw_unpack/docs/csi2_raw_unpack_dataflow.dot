  "sig:blast" -> "sig:nl";
  "sig:bq" -> "sig:nb";
  "sig:bq" -> "sig:px";
  "sig:cnt" -> "out:s_axis_*";
  "sig:cnt" -> "sig:cnt_pop";
  "sig:cnt" -> "sig:dropn";
  "sig:cnt" -> "sig:have_group";
  "sig:cnt" -> "sig:mis";
  "sig:cnt_pop" -> "sig:cnt";
