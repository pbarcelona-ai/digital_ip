  "sig:gsize" -> "sig:have_group";
  "sig:gsize" -> "sig:mis";
  "sig:gsize" -> "sig:popn";
  "sig:have_group" -> "sig:emit";
  "sig:is10" -> "sig:gsize";
  "sig:is10" -> "sig:plast";
  "sig:is10" -> "sig:px";
  "sig:is12" -> "sig:gsize";
  "sig:is12" -> "sig:plast";
  "sig:is12" -> "sig:px";
  "sig:mis" -> "sig:emit";
  "sig:mis" -> "sig:popn";
  "sig:nb" -> "sig:bq";
  "sig:nf" -> "sig:bfirst";
  "sig:nl" -> "sig:blast";
  "sig:out_free" -> "sig:emit";
  "sig:pi" -> "out:m_axis_*";
  "sig:pi" -> "sig:mis";
  "sig:pi" -> "sig:pi";
  "sig:pi" -> "sig:pop";
  "sig:pi" -> "sig:px";
  "sig:plast" -> "out:m_axis_*";
  "sig:plast" -> "sig:pi";
  "sig:plast" -> "sig:pop";
  "sig:pop" -> "sig:popn";
  "sig:popn" -> "sig:cnt_pop";
  "sig:popn" -> "sig:nb";
  "sig:popn" -> "sig:nf";
