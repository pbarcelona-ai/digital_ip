digraph "csi2_raw_unpack_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>csi2_raw_unpack</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/video/csi2_raw_unpack/src/csi2_raw_unpack.sv; clocks / resets (not drawn): clk, rst_n<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:fmt_i" "in:m_axis_*" "in:s_axis_*" }
    "in:fmt_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="fmt_i\n[5:0]"];
    "in:m_axis_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="m_axis_tready"];
    "in:s_axis_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="s_axis_*\ns_axis_tdata\ns_axis_tkeep\ns_axis_tlast\ns_axis_tuser\ns_axis_tvalid"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:m_axis_*" "out:s_axis_*" }
    "out:m_axis_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="m_axis_*\nm_axis_tdata\nm_axis_tlast\nm_axis_tuser\nm_axis_tvalid"];
    "out:s_axis_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="s_axis_tready"];
  }
  subgraph cluster_b0 { label="always_comb @ line 67"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:glast" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="glast"];
    "sig:px" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="px\n[OUT_W-1:0]"];
  }
  subgraph cluster_b1 { label="always_comb @ line 78"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:dropn" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="dropn\n[2:0]"];
    "sig:mis" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="mis"];
  }
  subgraph cluster_b2 { label="always_ff @ line 98"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:bfirst" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="bfirst\n[BUF-1:0]"];
    "sig:blast" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="blast\n[BUF-1:0]"];
    "sig:bq" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="bq\n[7:0] x [BUF]"];
    "sig:cnt" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="cnt\n[CW-1:0]"];
    "sig:nb" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="nb\n[7:0] x [BUF]"];
    "sig:nf" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="nf\n[BUF-1:0]"];
    "sig:nl" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="nl\n[BUF-1:0]"];
    "sig:pi" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="pi\n[1:0]"];
  }
  "sig:cnt_pop" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="cnt_pop\n[CW-1:0]"];
  "sig:emit" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="emit"];
  "sig:gsize" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="gsize\n[2:0]"];
  "sig:have_group" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="have_group"];
  "sig:is10" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="is10"];
  "sig:is12" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="is12"];
  "sig:out_free" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="out_free"];
  "sig:plast" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="plast\n[1:0]"];
  "sig:pop" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="pop"];
  "sig:popn" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="popn\n[2:0]"];
  "sig:push" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="push"];
  "in:fmt_i" -> "sig:is10";
  "in:fmt_i" -> "sig:is12";
  "in:m_axis_*" -> "out:m_axis_*";
  "in:m_axis_*" -> "sig:out_free";
  "in:s_axis_*" -> "sig:cnt";
  "in:s_axis_*" -> "sig:nb";
  "in:s_axis_*" -> "sig:nf";
  "in:s_axis_*" -> "sig:nl";
  "in:s_axis_*" -> "sig:push";
