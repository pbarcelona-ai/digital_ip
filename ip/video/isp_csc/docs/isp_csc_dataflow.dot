digraph "isp_csc_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>isp_csc</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/video/isp_csc/src/isp_csc.sv; clocks / resets (not drawn): clk, rst_n<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:bt709_i" "in:bypass_i" "in:m_axis_*" "in:s_axis_*" }
    "in:bt709_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="bt709_i"];
    "in:bypass_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="bypass_i"];
    "in:m_axis_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="m_axis_tready"];
    "in:s_axis_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="s_axis_*\ns_axis_tdata\ns_axis_tlast\ns_axis_tuser\ns_axis_tvalid"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:m_axis_*" "out:s_axis_*" }
    "out:m_axis_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="m_axis_*\nm_axis_tdata\nm_axis_tlast\nm_axis_tuser\nm_axis_tvalid"];
    "out:s_axis_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="s_axis_tready"];
  }
  subgraph cluster_b0 { label="always_ff @ line 51"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:b1" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="b1"];
    "sig:by_f" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="by_f"];
    "sig:d1" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="d1\n[23:0]"];
    "sig:l1" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="l1"];
    "sig:m709_f" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="m709_f"];
    "sig:scb" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="scb\n[18:0]"];
    "sig:scr" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="scr\n[18:0]"];
    "sig:sy" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="sy\n[18:0]"];
    "sig:u1" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="u1"];
    "sig:v1" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="v1"];
  }
  "sig:acc" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="acc"];
  "sig:b" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="b\n[9:0]"];
  "sig:by" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="by"];
  "sig:en" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="en"];
  "sig:g" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="g\n[9:0]"];
  "sig:m709" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="m709"];
  "sig:r" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="r\n[9:0]"];
  "in:bt709_i" -> "sig:m709";
  "in:bt709_i" -> "sig:m709_f";
  "in:bypass_i" -> "sig:by";
  "in:bypass_i" -> "sig:by_f";
  "in:m_axis_*" -> "sig:en";
  "in:s_axis_*" -> "sig:acc";
  "in:s_axis_*" -> "sig:b";
  "in:s_axis_*" -> "sig:by";
  "in:s_axis_*" -> "sig:by_f";
  "in:s_axis_*" -> "sig:d1";
  "in:s_axis_*" -> "sig:g";
  "in:s_axis_*" -> "sig:l1";
  "in:s_axis_*" -> "sig:m709";
  "in:s_axis_*" -> "sig:m709_f";
  "in:s_axis_*" -> "sig:r";
  "in:s_axis_*" -> "sig:u1";
  "out:m_axis_*" -> "sig:en";
  "sig:acc" -> "sig:by_f";
  "sig:acc" -> "sig:m709_f";
  "sig:acc" -> "sig:v1";
  "sig:b" -> "sig:scb";
  "sig:b" -> "sig:scr";
  "sig:b" -> "sig:sy";
  "sig:b1" -> "out:m_axis_*";
  "sig:by" -> "sig:b1";
  "sig:by_f" -> "sig:by";
  "sig:d1" -> "out:m_axis_*";
  "sig:en" -> "out:m_axis_*";
  "sig:en" -> "out:s_axis_*";
  "sig:en" -> "sig:acc";
  "sig:en" -> "sig:b1";
  "sig:en" -> "sig:by_f";
  "sig:en" -> "sig:d1";
  "sig:en" -> "sig:l1";
  "sig:en" -> "sig:m709_f";
  "sig:en" -> "sig:scb";
  "sig:en" -> "sig:scr";
  "sig:en" -> "sig:sy";
  "sig:en" -> "sig:u1";
  "sig:en" -> "sig:v1";
  "sig:g" -> "sig:scb";
  "sig:g" -> "sig:scr";
  "sig:g" -> "sig:sy";
  "sig:l1" -> "out:m_axis_*";
  "sig:m709" -> "sig:scb";
  "sig:m709" -> "sig:scr";
  "sig:m709" -> "sig:sy";
  "sig:m709_f" -> "sig:m709";
  "sig:r" -> "sig:scb";
  "sig:r" -> "sig:scr";
  "sig:r" -> "sig:sy";
  "sig:scb" -> "out:m_axis_*";
  "sig:scr" -> "out:m_axis_*";
  "sig:sy" -> "out:m_axis_*";
  "sig:u1" -> "out:m_axis_*";
  "sig:v1" -> "out:m_axis_*";
}
