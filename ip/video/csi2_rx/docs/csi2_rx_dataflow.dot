digraph "csi2_rx_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>csi2_rx</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/video/csi2_rx/src/csi2_rx.sv; clocks / resets (not drawn): clk, rst_n<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:dt_i" "in:lane_data_i" "in:lane_valid_i" "in:m_axis_*" "in:vc_i" }
    "in:dt_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="dt_i\n[5:0]"];
    "in:lane_data_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="lane_data_i\n[NLANES*8-1:0]"];
    "in:lane_valid_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="lane_valid_i\n[NLANES-1:0]"];
    "in:m_axis_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="m_axis_tready"];
    "in:vc_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="vc_i\n[1:0]"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:crc_error_o" "out:ecc_corrected_o" "out:ecc_error_o" "out:frame_end_o" "out:frame_start_o" "out:line_o" "out:m_axis_*" "out:overflow_o" }
    "out:crc_error_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="crc_error_o"];
