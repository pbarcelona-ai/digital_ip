digraph "conv2d_core_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>conv2d_core</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/video/conv2d_core/src/conv2d_core.sv; clocks / resets (not drawn): clk, rst_n<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:coef_i" "in:height_i" "in:m_axis_*" "in:s_axis_*" "in:shift_i" "in:width_i" }
    "in:coef_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="coef_i\n[N*N*COEF_W-1:0]"];
    "in:height_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="height_i\n[15:0]"];
    "in:m_axis_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="m_axis_tready"];
    "in:s_axis_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="s_axis_*\ns_axis_tdata\ns_axis_tlast\ns_axis_tuser\ns_axis_tvalid"];
    "in:shift_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="shift_i\n[4:0]"];
    "in:width_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="width_i\n[15:0]"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:frame_o" "out:m_axis_*" "out:sof_wait_o" }
    "out:frame_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="frame_o"];
    "out:m_axis_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="m_axis_*\nm_axis_tdata\nm_axis_tlast\nm_axis_tuser\nm_axis_tvalid"];
    "out:sof_wait_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="sof_wait_o"];
  }
  subgraph cluster_b0 { label="always_comb @ line 97"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:rs" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="rs\n[ACC_W-1:0] x [C*N]"];
    "sig:ts" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="ts\n[ACC_W-1:0] x [C]"];
  }
  subgraph cluster_b1 { label="always_ff @ line 109"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:v1" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="v1"];
    "sig:v2" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="v2"];
    "sig:v3" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="v3"];
    "sig:v4" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="v4"];
  }
  subgraph cluster_b2 { label="always_ff @ line 117"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:a3" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="a3\n[ACC_W-1:0] x [C]"];
    "sig:d4" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="d4\n[PW-1:0]"];
    "sig:l1" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="l1"];
    "sig:l2" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="l2"];
    "sig:l3" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="l3"];
    "sig:l4" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="l4"];
    "sig:p1" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="p1\n[PROD_W-1:0] x [C*NN]"];
    "sig:r2" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="r2\n[ACC_W-1:0] x [C*N]"];
    "sig:s1" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="s1\n[4:0]"];
    "sig:s2" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="s2\n[4:0]"];
    "sig:s3" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="s3\n[4:0]"];
    "sig:u1" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="u1"];
    "sig:u2" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="u2"];
    "sig:u3" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="u3"];
    "sig:u4" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="u4"];
  }
  subgraph cluster_b3 { label="always_ff @ line 72"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:coef_q" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="coef_q\n[NN*COEF_W-1:0]"];
    "sig:shift_q" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="shift_q\n[4:0]"];
  }
  "sig:adv" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="adv"];
  "sig:k" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="k\n[NN*COEF_W-1:0]"];
  "sig:ks" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="ks\n[4:0]"];
  "sig:take" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="take"];
  "sig:w_d" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="w_d\n[NN*PW-1:0]"];
  "sig:w_l" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="w_l"];
  "sig:w_r" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="w_r"];
  "sig:w_u" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="w_u"];
  "sig:w_v" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="w_v"];
  "inst:u_win" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>isp_window</B><BR/><FONT COLOR="#4b5563">u_win</FONT>>];
  "in:coef_i" -> "sig:coef_q";
  "in:coef_i" -> "sig:k";
  "in:height_i" -> "inst:u_win";
  "in:m_axis_*" -> "sig:adv";
  "in:shift_i" -> "sig:ks";
  "in:shift_i" -> "sig:shift_q";
  "in:width_i" -> "inst:u_win";
  "inst:u_win" -> "out:sof_wait_o";
  "inst:u_win" -> "sig:w_d";
  "inst:u_win" -> "sig:w_l";
  "inst:u_win" -> "sig:w_u";
  "inst:u_win" -> "sig:w_v";
  "sig:a3" -> "sig:d4";
  "sig:adv" -> "sig:a3";
  "sig:adv" -> "sig:d4";
  "sig:adv" -> "sig:l1";
  "sig:adv" -> "sig:l2";
  "sig:adv" -> "sig:l3";
  "sig:adv" -> "sig:l4";
  "sig:adv" -> "sig:p1";
  "sig:adv" -> "sig:r2";
  "sig:adv" -> "sig:s1";
  "sig:adv" -> "sig:s2";
  "sig:adv" -> "sig:s3";
  "sig:adv" -> "sig:u1";
  "sig:adv" -> "sig:u2";
  "sig:adv" -> "sig:u3";
  "sig:adv" -> "sig:u4";
  "sig:adv" -> "sig:v1";
  "sig:adv" -> "sig:v2";
  "sig:adv" -> "sig:v3";
  "sig:adv" -> "sig:v4";
  "sig:adv" -> "sig:w_r";
  "sig:coef_q" -> "sig:k";
  "sig:d4" -> "out:m_axis_*";
  "sig:k" -> "sig:p1";
  "sig:ks" -> "sig:s1";
  "sig:l1" -> "sig:l2";
  "sig:l2" -> "sig:l3";
  "sig:l3" -> "sig:l4";
  "sig:l4" -> "out:m_axis_*";
  "sig:p1" -> "sig:rs";
  "sig:r2" -> "sig:ts";
  "sig:rs" -> "sig:r2";
  "sig:rs" -> "sig:rs";
  "sig:s1" -> "sig:s2";
  "sig:s2" -> "sig:s3";
  "sig:s2" -> "sig:ts";
  "sig:s3" -> "sig:d4";
  "sig:shift_q" -> "sig:ks";
  "sig:take" -> "out:frame_o";
  "sig:take" -> "sig:coef_q";
  "sig:take" -> "sig:shift_q";
  "sig:ts" -> "sig:a3";
  "sig:ts" -> "sig:ts";
  "sig:u1" -> "sig:u2";
  "sig:u2" -> "sig:u3";
  "sig:u3" -> "sig:u4";
  "sig:u4" -> "out:m_axis_*";
  "sig:v1" -> "sig:v2";
  "sig:v2" -> "sig:v3";
  "sig:v3" -> "sig:v4";
  "sig:v4" -> "out:m_axis_*";
  "sig:v4" -> "sig:adv";
  "sig:w_d" -> "sig:p1";
  "sig:w_l" -> "sig:l1";
  "sig:w_r" -> "inst:u_win";
  "sig:w_r" -> "sig:take";
  "sig:w_u" -> "sig:k";
  "sig:w_u" -> "sig:ks";
  "sig:w_u" -> "sig:take";
  "sig:w_u" -> "sig:u1";
  "sig:w_v" -> "sig:take";
  "sig:w_v" -> "sig:v1";
  "in:s_axis_*" -> "inst:u_win" [penwidth=3.2, color="#0f766e", fontcolor="#0f766e", fontname="Courier", fontsize=9, label="AXI4-Stream
s_axis_t* (5)"];
