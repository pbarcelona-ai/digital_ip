digraph "isp_stats_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>isp_stats</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/video/isp_stats/src/isp_stats.sv; clocks / resets (not drawn): clk, rst_n<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:flush_i" "in:sat_thr_i" "in:tdata" "in:tready" "in:tuser" "in:tvalid" }
    "in:flush_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="flush_i"];
    "in:sat_thr_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="sat_thr_i\n[CW-1:0]"];
    "in:tdata" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="tdata\n[3*CW-1:0]"];
    "in:tready" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="tready"];
    "in:tuser" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="tuser"];
    "in:tvalid" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="tvalid"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:clipped_o" "out:frame_done_o" "out:frames_o" "out:pixels_o" "out:sum_b_o" "out:sum_g_o" "out:sum_r_o" }
    "out:clipped_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="clipped_o\n[31:0]"];
    "out:frame_done_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="frame_done_o"];
    "out:frames_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="frames_o\n[31:0]"];
    "out:pixels_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="pixels_o\n[31:0]"];
    "out:sum_b_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="sum_b_o\n[39:0]"];
    "out:sum_g_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="sum_g_o\n[39:0]"];
    "out:sum_r_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="sum_r_o\n[39:0]"];
  }
  subgraph cluster_b0 { label="always_ff @ line 42"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:ab" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="ab\n[39:0]"];
    "sig:active" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="active"];
    "sig:ag" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="ag\n[39:0]"];
    "sig:ar" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="ar\n[39:0]"];
    "sig:nc" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="nc\n[31:0]"];
    "sig:np" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="np\n[31:0]"];
  }
  "sig:b" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="b\n[CW-1:0]"];
  "sig:beat" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="beat"];
  "sig:clip" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="clip"];
  "sig:close" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="close"];
  "sig:g" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="g\n[CW-1:0]"];
  "sig:r" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="r\n[CW-1:0]"];
  "in:flush_i" -> "sig:active";
  "in:flush_i" -> "sig:close";
  "in:sat_thr_i" -> "sig:clip";
  "in:tdata" -> "sig:b";
  "in:tdata" -> "sig:g";
  "in:tdata" -> "sig:r";
  "in:tready" -> "sig:beat";
  "in:tuser" -> "sig:ab";
  "in:tuser" -> "sig:active";
  "in:tuser" -> "sig:ag";
  "in:tuser" -> "sig:ar";
  "in:tuser" -> "sig:close";
  "in:tuser" -> "sig:nc";
  "in:tuser" -> "sig:np";
  "in:tvalid" -> "sig:beat";
  "out:frames_o" -> "out:frames_o";
  "sig:ab" -> "out:sum_b_o";
  "sig:ab" -> "sig:ab";
  "sig:active" -> "sig:ab";
  "sig:active" -> "sig:active";
  "sig:active" -> "sig:ag";
  "sig:active" -> "sig:ar";
  "sig:active" -> "sig:close";
  "sig:active" -> "sig:nc";
  "sig:active" -> "sig:np";
  "sig:ag" -> "out:sum_g_o";
  "sig:ag" -> "sig:ag";
  "sig:ar" -> "out:sum_r_o";
  "sig:ar" -> "sig:ar";
  "sig:b" -> "sig:ab";
  "sig:b" -> "sig:clip";
  "sig:beat" -> "sig:ab";
  "sig:beat" -> "sig:active";
  "sig:beat" -> "sig:ag";
  "sig:beat" -> "sig:ar";
  "sig:beat" -> "sig:close";
  "sig:beat" -> "sig:nc";
  "sig:beat" -> "sig:np";
  "sig:clip" -> "sig:nc";
  "sig:close" -> "out:clipped_o";
  "sig:close" -> "out:frame_done_o";
  "sig:close" -> "out:frames_o";
  "sig:close" -> "out:pixels_o";
  "sig:close" -> "out:sum_b_o";
  "sig:close" -> "out:sum_g_o";
  "sig:close" -> "out:sum_r_o";
  "sig:g" -> "sig:ag";
  "sig:g" -> "sig:clip";
  "sig:nc" -> "out:clipped_o";
  "sig:nc" -> "sig:nc";
  "sig:np" -> "out:pixels_o";
  "sig:np" -> "sig:np";
  "sig:r" -> "sig:ar";
  "sig:r" -> "sig:clip";
}
