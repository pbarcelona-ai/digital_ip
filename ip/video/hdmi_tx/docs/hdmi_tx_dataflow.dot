digraph "hdmi_tx_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>hdmi_tx</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/video/hdmi_tx/src/hdmi_tx.sv; clocks / resets (not drawn): clk, rst_n<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:avi_c_i" "in:avi_m_i" "in:avi_q_i" "in:avi_vic_i" "in:avi_y_i" "in:de_i" "in:hdmi_mode_i" "in:hs_i" "in:rgb_i" "in:vs_i" "in:vs_pol_i" }
    "in:avi_c_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="avi_c_i\n[1:0]"];
    "in:avi_m_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="avi_m_i\n[1:0]"];
    "in:avi_q_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="avi_q_i\n[1:0]"];
    "in:avi_vic_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="avi_vic_i\n[6:0]"];
    "in:avi_y_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="avi_y_i\n[1:0]"];
    "in:de_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="de_i"];
    "in:hdmi_mode_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="hdmi_mode_i"];
    "in:hs_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="hs_i"];
    "in:rgb_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="rgb_i\n[23:0]"];
    "in:vs_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="vs_i"];
    "in:vs_pol_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="vs_pol_i"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:tmds0_o" "out:tmds1_o" "out:tmds2_o" "out:tmds_clk_o" }
    "out:tmds0_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="tmds0_o\n[9:0]"];
    "out:tmds1_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="tmds1_o\n[9:0]"];
    "out:tmds2_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="tmds2_o\n[9:0]"];
    "out:tmds_clk_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="tmds_clk_o\n[9:0]"];
  }
  subgraph cluster_b0 { label="always_comb @ line 115"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:c0" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="c0\n[1:0]"];
    "sig:c1" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="c1\n[1:0]"];
    "sig:c2" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="c2\n[1:0]"];
