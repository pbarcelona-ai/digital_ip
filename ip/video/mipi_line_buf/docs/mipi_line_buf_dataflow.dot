  "in:px_valid_i" -> "sig:wr_px";
  "in:rd_addr_i" -> "out:rd_data_o";
  "in:rd_buf_i" -> "inst:u_free0";
  "in:rd_buf_i" -> "inst:u_free1";
  "in:rd_buf_i" -> "out:rd_data_o";
  "inst:u_free0" -> "sig:freed";
  "inst:u_free1" -> "sig:freed";
  "sig:cur_b" -> "sig:waddr";
  "sig:dropping" -> "out:line_buf_o";
  "sig:dropping" -> "out:line_drop_o";
  "sig:dropping" -> "out:line_ready_o";
  "sig:dropping" -> "out:line_width_o";
  "sig:dropping" -> "sig:free";
