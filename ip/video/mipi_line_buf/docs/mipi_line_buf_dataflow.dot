digraph "mipi_line_buf_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>mipi_line_buf</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/video/mipi_line_buf/src/mipi_line_buf.sv; clocks / resets (not drawn): bclk, pclk<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:brst_n" "in:done_i" "in:line_end_i" "in:prst_n" "in:px_i" "in:px_valid_i" "in:rd_addr_i" "in:rd_buf_i" }
    "in:brst_n" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="brst_n"];
    "in:done_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="done_i"];
    "in:line_end_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="line_end_i"];
    "in:prst_n" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="prst_n"];
    "in:px_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="px_i\n[23:0]"];
    "in:px_valid_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="px_valid_i"];
    "in:rd_addr_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="rd_addr_i\n[$clog2(MAX_W/2)-1:0]"];
    "in:rd_buf_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="rd_buf_i"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:line_buf_o" "out:line_drop_o" "out:line_ready_o" "out:line_width_o" "out:rd_data_o" }
    "out:line_buf_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="line_buf_o"];
    "out:line_drop_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="line_drop_o"];
    "out:line_ready_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="line_ready_o"];
    "out:line_width_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="line_width_o\n[15:0]"];
    "out:rd_data_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="rd_data_o\n[47:0]"];
  }
  subgraph cluster_b0 { label="always_comb @ line 61"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:waddr" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="waddr\n[AW:0]"];
    "sig:wdata" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="wdata\n[47:0]"];
    "sig:we" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="we"];
  }
  subgraph cluster_b1 { label="always_ff @ line 43"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:mem" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="mem\n[47:0] x [2*(MAX_W/2)]"];
  }
  subgraph cluster_b2 { label="always_ff @ line 69"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:dropping" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="dropping"];
    "sig:free" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="free\n[1:0]"];
    "sig:hold" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="hold\n[23:0]"];
    "sig:in_line" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="in_line"];
    "sig:wb" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="wb"];
    "sig:wp" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="wp\n[15:0]"];
  }
  "sig:cur_b" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="cur_b"];
  "sig:freed" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="freed\n[1:0]"];
  "sig:room" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="room"];
  "sig:start" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="start"];
  "sig:use_b" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="use_b"];
  "sig:wr_px" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="wr_px"];
  "inst:u_free0" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>pulse_sync</B><BR/><FONT COLOR="#4b5563">u_free0</FONT>>];
  "inst:u_free1" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>pulse_sync</B><BR/><FONT COLOR="#4b5563">u_free1</FONT>>];
  "in:brst_n" -> "inst:u_free0";
  "in:brst_n" -> "inst:u_free1";
  "in:done_i" -> "inst:u_free0";
  "in:done_i" -> "inst:u_free1";
  "in:line_end_i" -> "out:line_buf_o";
  "in:line_end_i" -> "out:line_drop_o";
  "in:line_end_i" -> "out:line_ready_o";
  "in:line_end_i" -> "out:line_width_o";
  "in:line_end_i" -> "sig:dropping";
  "in:line_end_i" -> "sig:free";
  "in:line_end_i" -> "sig:in_line";
  "in:line_end_i" -> "sig:waddr";
  "in:line_end_i" -> "sig:wb";
  "in:line_end_i" -> "sig:wdata";
  "in:line_end_i" -> "sig:we";
  "in:line_end_i" -> "sig:wp";
  "in:prst_n" -> "inst:u_free0";
