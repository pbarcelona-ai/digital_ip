  }
  subgraph cluster_b0 { label="always_comb @ line 168"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:out_c" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="out_c\n[PIX_W-1:0]"];
    "sig:s" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="s\n[VW-1:0]"];
