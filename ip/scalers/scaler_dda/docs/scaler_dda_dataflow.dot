digraph "scaler_dda_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>scaler_dda</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/scalers/scaler_dda/src/scaler_dda.sv; clocks / resets (not drawn): clk, rst_n<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:adv" "in:hold" "in:offs_x" "in:offs_y" "in:out_h" "in:out_w" "in:start" "in:step_x" "in:step_y" }
    "in:adv" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="adv"];
    "in:hold" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="hold"];
    "in:offs_x" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="offs_x\n[31:0]"];
    "in:offs_y" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="offs_y\n[31:0]"];
    "in:out_h" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="out_h\n[15:0]"];
    "in:out_w" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="out_w\n[15:0]"];
    "in:start" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="start"];
    "in:step_x" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="step_x\n[31:0]"];
    "in:step_y" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="step_y\n[31:0]"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:busy" "out:nxt_y" "out:o_eof" "out:o_eol" "out:o_sof" "out:o_valid" "out:o_x" "out:o_y" }
    "out:busy" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="busy"];
    "out:nxt_y" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="nxt_y\n[31:0]"];
    "out:o_eof" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="o_eof"];
    "out:o_eol" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="o_eol"];
    "out:o_sof" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="o_sof"];
    "out:o_valid" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="o_valid"];
    "out:o_x" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="o_x\n[31:0]"];
    "out:o_y" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="o_y\n[31:0]"];
  }
  subgraph cluster_b0 { label="always_ff @ line 47"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:ax" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="ax\n[31:0]"];
    "sig:ay" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="ay\n[31:0]"];
    "sig:ox" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="ox\n[15:0]"];
    "sig:oy" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="oy\n[15:0]"];
  }
  "sig:last_col" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="last_col"];
  "sig:last_row" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="last_row"];
  "in:adv" -> "out:busy";
  "in:adv" -> "out:o_eof";
  "in:adv" -> "out:o_eol";
  "in:adv" -> "out:o_sof";
  "in:adv" -> "out:o_valid";
  "in:adv" -> "out:o_x";
  "in:adv" -> "out:o_y";
  "in:adv" -> "sig:ax";
  "in:adv" -> "sig:ay";
  "in:adv" -> "sig:ox";
  "in:adv" -> "sig:oy";
  "in:hold" -> "out:busy";
  "in:hold" -> "out:o_eof";
  "in:hold" -> "out:o_eol";
  "in:hold" -> "out:o_sof";
  "in:hold" -> "out:o_valid";
  "in:hold" -> "out:o_x";
  "in:hold" -> "out:o_y";
  "in:hold" -> "sig:ax";
  "in:hold" -> "sig:ay";
  "in:hold" -> "sig:ox";
  "in:hold" -> "sig:oy";
  "in:offs_x" -> "sig:ax";
  "in:offs_y" -> "sig:ay";
  "in:out_h" -> "sig:last_row";
  "in:out_w" -> "sig:last_col";
  "in:start" -> "out:busy";
  "in:start" -> "out:o_eof";
  "in:start" -> "out:o_eol";
  "in:start" -> "out:o_sof";
  "in:start" -> "out:o_valid";
  "in:start" -> "out:o_x";
  "in:start" -> "out:o_y";
  "in:start" -> "sig:ax";
  "in:start" -> "sig:ay";
  "in:start" -> "sig:ox";
  "in:start" -> "sig:oy";
  "in:step_x" -> "sig:ax";
  "in:step_y" -> "sig:ay";
  "out:busy" -> "out:busy";
  "out:busy" -> "out:o_eof";
  "out:busy" -> "out:o_eol";
  "out:busy" -> "out:o_sof";
  "out:busy" -> "out:o_valid";
  "out:busy" -> "out:o_x";
  "out:busy" -> "out:o_y";
  "out:busy" -> "sig:ax";
  "out:busy" -> "sig:ay";
  "out:busy" -> "sig:ox";
  "out:busy" -> "sig:oy";
  "sig:ax" -> "out:o_x";
  "sig:ax" -> "sig:ax";
  "sig:ay" -> "out:nxt_y";
  "sig:ay" -> "out:o_y";
  "sig:ay" -> "sig:ay";
  "sig:last_col" -> "out:busy";
  "sig:last_col" -> "out:o_eof";
  "sig:last_col" -> "out:o_eol";
  "sig:last_col" -> "sig:ax";
  "sig:last_col" -> "sig:ay";
  "sig:last_col" -> "sig:ox";
  "sig:last_col" -> "sig:oy";
  "sig:last_row" -> "out:busy";
  "sig:last_row" -> "out:o_eof";
  "sig:ox" -> "out:o_sof";
  "sig:ox" -> "sig:last_col";
  "sig:ox" -> "sig:ox";
  "sig:oy" -> "out:o_sof";
  "sig:oy" -> "sig:last_row";
  "sig:oy" -> "sig:oy";
}
