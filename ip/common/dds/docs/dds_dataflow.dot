digraph "dds_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>dds</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/common/dds/src/dds.sv; clocks / resets (not drawn): clk, rst_n<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:en_i" "in:phase_load_i" "in:phase_off_i" "in:sync_load_i" "in:tuning_i" }
    "in:en_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="en_i"];
    "in:phase_load_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="phase_load_i\n[PHASE_W-1:0]"];
    "in:phase_off_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="phase_off_i\n[PHASE_W-1:0]"];
    "in:sync_load_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="sync_load_i"];
    "in:tuning_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="tuning_i\n[PHASE_W-1:0]"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:cos_o" "out:nyquist_o" "out:sin_o" "out:valid_o" }
    "out:cos_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="cos_o\n[OUT_W-1:0]"];
    "out:nyquist_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="nyquist_o"];
    "out:sin_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="sin_o\n[OUT_W-1:0]"];
    "out:valid_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="valid_o"];
  }
  subgraph cluster_b0 { label="always_ff @ line 42"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:en_d" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="en_d"];
  }
  "sig:nco_carry" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="nco_carry"];
  "sig:nco_msb" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="nco_msb"];
  "sig:ph" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="ph\n[PHASE_W-1:0]"];
  "inst:u_nco" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>nco</B><BR/><FONT COLOR="#4b5563">u_nco</FONT>>];
  "inst:u_cordic" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>cordic</B><BR/><FONT COLOR="#4b5563">u_cordic</FONT>>];
  "in:en_i" -> "inst:u_nco";
  "in:en_i" -> "sig:en_d";
  "in:phase_load_i" -> "inst:u_nco";
  "in:phase_off_i" -> "inst:u_nco";
  "in:sync_load_i" -> "inst:u_nco";
  "in:sync_load_i" -> "sig:en_d";
  "in:tuning_i" -> "inst:u_nco";
  "inst:u_cordic" -> "out:cos_o";
  "inst:u_cordic" -> "out:sin_o";
  "inst:u_cordic" -> "out:valid_o";
  "inst:u_nco" -> "out:nyquist_o";
  "inst:u_nco" -> "sig:nco_carry";
  "inst:u_nco" -> "sig:nco_msb";
  "inst:u_nco" -> "sig:ph";
  "sig:en_d" -> "inst:u_cordic";
  "sig:ph" -> "inst:u_cordic";
}
