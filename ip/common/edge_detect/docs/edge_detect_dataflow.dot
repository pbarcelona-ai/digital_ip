digraph "edge_detect_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>edge_detect</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/common/edge_detect/src/edge_detect.sv; clocks / resets (not drawn): clk, rst_n<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:d_i" }
    "in:d_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="d_i\n[WIDTH-1:0]"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:pulse_o" }
    "out:pulse_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="pulse_o\n[WIDTH-1:0]"];
  }
  subgraph cluster_b0 { label="always_ff @ line 30"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:a" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="a\n[WIDTH-1:0]"];
    "sig:b" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="b\n[WIDTH-1:0]"];
  }
  subgraph cluster_b1 { label="always_ff @ line 38"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:prev" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="prev\n[WIDTH-1:0]"];
  }
  "sig:cur" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="cur\n[WIDTH-1:0]"];
  "in:d_i" -> "sig:a";
  "in:d_i" -> "sig:cur";
  "sig:a" -> "sig:b";
  "sig:b" -> "sig:cur";
  "sig:cur" -> "out:pulse_o";
  "sig:cur" -> "sig:prev";
  "sig:prev" -> "out:pulse_o";
}
