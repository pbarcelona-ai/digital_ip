digraph "priority_encoder_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>priority_encoder</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/common/priority_encoder/src/priority_encoder.sv; clocks / resets (not drawn): clk, rst_n<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:req_i" }
    "in:req_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="req_i\n[WIDTH-1:0]"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:idx_o" "out:onehot_o" "out:valid_o" }
    "out:idx_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="idx_o\n[$clog2(WIDTH)-1:0]"];
    "out:onehot_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="onehot_o\n[WIDTH-1:0]"];
    "out:valid_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="valid_o"];
  }
  subgraph cluster_b0 { label="always_comb @ line 30"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:idx_c" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="idx_c\n[IW-1:0]"];
    "sig:oh_c" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="oh_c\n[WIDTH-1:0]"];
    "sig:v_c" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="v_c"];
  }
  "in:req_i" -> "sig:idx_c";
  "in:req_i" -> "sig:oh_c";
  "in:req_i" -> "sig:v_c";
  "sig:idx_c" -> "out:idx_o";
  "sig:oh_c" -> "out:onehot_o";
  "sig:v_c" -> "out:valid_o";
}
