digraph "sync_fifo_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>sync_fifo</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/fifo/sync_fifo/src/sync_fifo.sv; clocks / resets (not drawn): clk, rst_n<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:aempty_thresh_i" "in:afull_thresh_i" "in:clr_err_i" "in:rd_en_i" "in:wdata_i" "in:wr_en_i" }
    "in:aempty_thresh_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="aempty_thresh_i\n[$clog2(DEPTH):0]"];
    "in:afull_thresh_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="afull_thresh_i\n[$clog2(DEPTH):0]"];
    "in:clr_err_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="clr_err_i"];
    "in:rd_en_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="rd_en_i"];
    "in:wdata_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="wdata_i\n[WIDTH-1:0]"];
    "in:wr_en_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="wr_en_i"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:almost_empty_o" "out:almost_full_o" "out:empty_o" "out:full_o" "out:level_o" "out:overflow_o" "out:rd_valid_o" "out:rdata_o" "out:underflow_o" }
    "out:almost_empty_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="almost_empty_o"];
    "out:almost_full_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="almost_full_o"];
    "out:empty_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="empty_o"];
    "out:full_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="full_o"];
    "out:level_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="level_o\n[$clog2(DEPTH):0]"];
    "out:overflow_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="overflow_o"];
    "out:rd_valid_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="rd_valid_o"];
    "out:rdata_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="rdata_o\n[WIDTH-1:0]"];
    "out:underflow_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="underflow_o"];
  }
  subgraph cluster_b0 { label="always_ff @ line 47"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:mem" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="mem\n[WIDTH-1:0] x [0:DEPTH-1]"];
  }
  subgraph cluster_b1 { label="always_ff @ line 48"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:rptr" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="rptr\n[AW:0]"];
    "sig:wptr" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="wptr\n[AW:0]"];
  }
  "sig:do_rd" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="do_rd"];
  "sig:do_wr" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="do_wr"];
  "in:aempty_thresh_i" -> "out:almost_empty_o";
  "in:afull_thresh_i" -> "out:almost_full_o";
  "in:clr_err_i" -> "out:overflow_o";
  "in:clr_err_i" -> "out:underflow_o";
  "in:rd_en_i" -> "out:underflow_o";
  "in:rd_en_i" -> "sig:do_rd";
  "in:wdata_i" -> "sig:mem";
  "in:wr_en_i" -> "out:overflow_o";
  "in:wr_en_i" -> "sig:do_wr";
  "out:empty_o" -> "out:underflow_o";
  "out:empty_o" -> "sig:do_rd";
  "out:full_o" -> "out:overflow_o";
  "out:full_o" -> "sig:do_wr";
  "out:level_o" -> "out:almost_empty_o";
  "out:level_o" -> "out:almost_full_o";
  "out:level_o" -> "out:full_o";
  "sig:do_rd" -> "out:almost_empty_o";
  "sig:do_rd" -> "out:almost_full_o";
  "sig:do_rd" -> "out:rd_valid_o";
  "sig:do_rd" -> "out:rdata_o";
  "sig:do_rd" -> "sig:rptr";
  "sig:do_wr" -> "out:almost_empty_o";
  "sig:do_wr" -> "out:almost_full_o";
  "sig:do_wr" -> "sig:mem";
  "sig:do_wr" -> "sig:wptr";
  "sig:mem" -> "out:rdata_o";
  "sig:rptr" -> "out:empty_o";
  "sig:rptr" -> "out:level_o";
  "sig:rptr" -> "out:rdata_o";
  "sig:rptr" -> "sig:rptr";
  "sig:wptr" -> "out:empty_o";
  "sig:wptr" -> "out:level_o";
  "sig:wptr" -> "sig:mem";
  "sig:wptr" -> "sig:wptr";
}
