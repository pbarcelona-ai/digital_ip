    "sig:filt" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="filt\n[WIDTH-1:0]"];
    "sig:prev" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="prev\n[WIDTH-1:0]"];
  }
