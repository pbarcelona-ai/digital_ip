    "sig:evt_cnt" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="evt_cnt\n[31:0]"];
    "sig:fall_pend" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="fall_pend\n[WIDTH-1:0]"];
    "sig:rise_pend" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="rise_pend\n[WIDTH-1:0]"];
    "sig:ts" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="ts\n[TS_W-1:0]"];
  }
  subgraph cluster_b2 { label="always_ff @ line 136"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:ev_data" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="ev_data\n[DW-1:0]"];
    "sig:ev_valid" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="ev_valid"];
