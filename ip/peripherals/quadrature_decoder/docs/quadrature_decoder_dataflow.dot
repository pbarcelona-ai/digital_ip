    "sig:s2" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="s2\n[2:0]"];
  }
  "sig:a" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="a\n[3:0]"];
  "sig:b" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="b"];
