digraph "quadrature_decoder_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>quad_dec_top</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/peripherals/quadrature_decoder/src/quad_dec_top.sv; clocks / resets (not drawn): aclk, aresetn<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:enc_a_i" "in:enc_b_i" "in:enc_z_i" "in:m_axis_*" "in:s_axil_*" }
    "in:enc_a_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="enc_a_i"];
    "in:enc_b_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="enc_b_i"];
    "in:enc_z_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="enc_z_i"];
    "in:m_axis_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="m_axis_tready"];
    "in:s_axil_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="s_axil_*\ns_axil_awaddr\ns_axil_awvalid\ns_axil_wdata\ns_axil_wstrb\ns_axil_wvalid\ns_axil_bready\ns_axil_araddr\ns_axil_arvalid\ns_axil_rready"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:m_axis_*" "out:s_axil_*" }
    "out:m_axis_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="m_axis_*\nm_axis_tdata\nm_axis_tvalid\nm_axis_tlast"];
    "out:s_axil_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="s_axil_*\ns_axil_awready\ns_axil_wready\ns_axil_bresp\ns_axil_bvalid\ns_axil_arready\ns_axil_rdata\ns_axil_rresp\ns_axil_rvalid"];
  }
  subgraph cluster_b0 { label="always @ line 57"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:ip_chk_b_q" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="ip_chk_b_q"];
    "sig:ip_chk_r_q" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="ip_chk_r_q"];
  }
  subgraph cluster_b1 { label="always_comb @ line 104"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:step_dn" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="step_dn"];
    "sig:step_err" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="step_err"];
    "sig:step_up" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="step_up"];
  }
  subgraph cluster_b2 { label="always_ff @ line 114"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:ab_prev" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="ab_prev\n[1:0]"];
    "sig:dir" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="dir"];
    "sig:err_cnt" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="err_cnt\n[31:0]"];
    "sig:err_f" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="err_f"];
    "sig:idx_f" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="idx_f"];
    "sig:idx_pos" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="idx_pos\n[31:0]"];
    "sig:pos" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="pos\n[31:0]"];
    "sig:win_cnt" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="win_cnt\n[31:0]"];
    "sig:z_prev" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="z_prev"];
  }
  subgraph cluster_b3 { label="always_ff @ line 141"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:vel" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="vel\n[31:0]"];
    "sig:win_load" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="win_load"];
