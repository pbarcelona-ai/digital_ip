{
  "name": "spi_flash_ctrl_regs",
  "ip": "spi_flash_ctrl",
  "id": "SPFL",
  "version": "1.10",
  "desc": "SPI NOR flash controller: generic command, address, length, clock divider, status, interrupt enable.",
  "addr_width": 8,
  "clk": "aclk",
  "rst_n": "aresetn",
  "registers": [
    {"name": "CMD", "offset": "0x10", "access": "RW", "desc": "write starts a command (ignored and CMD_ERR while busy); reads back the last one",
     "fields": [{"name": "OPCODE", "bit": "7:0", "desc": "flash opcode"}, {"name": "ADDR_EN", "bit": 8, "desc": "send the 3 address bytes"},
                {"name": "DUMMY", "bit": "15:12", "desc": "dummy bytes after the address"}, {"name": "READ_DATA", "bit": 16, "desc": "LEN data bytes read to m_axis"},
                {"name": "WRITE_DATA", "bit": 17, "desc": "LEN data bytes written from s_axis"}]},
    {"name": "ADDR", "offset": "0x14", "access": "RW", "width": 24, "desc": "flash address (3 bytes)"},
    {"name": "LEN", "offset": "0x18", "access": "RW", "width": 16, "desc": "data bytes (0..65535)"},
    {"name": "CLKDIV", "offset": "0x1C", "access": "RW", "width": 16, "reset": "4", "desc": "sclk half period in clocks (minimum 3)"},
    {"name": "STATUS", "offset": "0x20", "access": "CMD", "width": 3, "desc": "status; write 1 to [2:1] to clear those flags",
     "fields": [{"name": "BUSY", "bit": 0, "desc": "command in progress"}, {"name": "DONE", "bit": 1, "desc": "command finished (sticky, W1C)"},
                {"name": "CMD_ERR", "bit": 2, "desc": "CMD written while busy (sticky, W1C)"}]},
    {"name": "IRQ_EN", "offset": "0x24", "access": "RW", "width": 1, "desc": "[0] irq_o = DONE"}
  ]
}
