digraph "spi_flash_ctrl_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>spi_flash_ctrl</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/peripherals/spi_flash_ctrl/src/spi_flash_ctrl.sv; clocks / resets (not drawn): aclk, aresetn<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:m_axis_*" "in:miso_i" "in:s_axil_*" "in:s_axis_*" }
    "in:m_axis_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="m_axis_tready"];
    "in:miso_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="miso_i"];
    "in:s_axil_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="s_axil_*\ns_axil_awaddr\ns_axil_awvalid\ns_axil_wdata\ns_axil_wstrb\ns_axil_wvalid\ns_axil_bready\ns_axil_araddr\ns_axil_arvalid\ns_axil_rready"];
    "in:s_axis_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="s_axis_*\ns_axis_tdata\ns_axis_tvalid"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:cs_n_o" "out:irq_o" "out:m_axis_*" "out:mosi_o" "out:s_axis_*" "out:sclk_o" }
    "out:cs_n_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="cs_n_o"];
    "out:irq_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="irq_o"];
    "out:m_axis_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="m_axis_*\nm_axis_tdata\nm_axis_tvalid\nm_axis_tlast"];
    "out:mosi_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="mosi_o"];
    "out:s_axis_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="s_axis_tready"];
    "out:sclk_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="sclk_o"];
  }
  subgraph cluster_b0 { label="always_comb @ line 140"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:rd" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="rd\n[8*32-1:0]"];
  }
  subgraph cluster_b1 { label="always_ff @ line 89"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:miso_s" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="miso_s"];
    "sig:miso_s1" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="miso_s1"];
  }
  subgraph cluster_b2 { label="always_ff @ line 90"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:addr" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="addr\n[23:0]"];
    "sig:addr_left" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="addr_left\n[1:0]"];
    "sig:bit_i" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="bit_i\n[2:0]"];
    "sig:cs_wait" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="cs_wait\n[15:0]"];
    "sig:data_left" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="data_left\n[15:0]"];
    "sig:done_f" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="done_f"];
    "sig:dummy_left" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="dummy_left\n[3:0]"];
    "sig:err_f" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="err_f"];
    "sig:hc" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="hc\n[15:0]"];
    "sig:is_rx" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="is_rx"];
    "sig:last_rx" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="last_rx"];
    "sig:opcode" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="opcode\n[7:0]"];
    "sig:rd_en" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="rd_en"];
    "sig:rx_sr" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="rx_sr\n[7:0]"];
    "sig:sclk_hi" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="sclk_hi"];
    "sig:sent_op" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="sent_op"];
    "sig:st" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="st"];
    "sig:tx_sr" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="tx_sr\n[7:0]"];
    "sig:wr_en" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="wr_en"];
  }
  "sig:half" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="half\n[15:0]"];
  "sig:hc_done" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="hc_done"];
  "sig:r_addr" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="r_addr\n[31:0]"];
  "sig:r_cmd" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="r_cmd\n[31:0]"];
  "sig:r_div" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="r_div\n[31:0]"];
  "sig:r_irqen" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="r_irqen\n[31:0]"];
  "sig:r_len" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="r_len\n[31:0]"];
  "sig:regs" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="regs\n[8*32-1:0]"];
  "sig:start" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="start"];
  "sig:wr_data" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="wr_data\n[31:0]"];
  "sig:wr_pulse" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="wr_pulse\n[7:0]"];
  "inst:u_regs" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>ip_axil_regs</B><BR/><FONT COLOR="#4b5563">u_regs</FONT>>];
