digraph "uart_tx_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>uart_tx</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/peripherals/uart/src/uart_tx.sv; clocks / resets (not drawn): clk, rst_n<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:data_bits_i" "in:en_i" "in:parity_en_i" "in:parity_odd_i" "in:s_*" "in:stop2_i" "in:tick16_i" }
    "in:data_bits_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="data_bits_i\n[3:0]"];
    "in:en_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="en_i"];
    "in:parity_en_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="parity_en_i"];
    "in:parity_odd_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="parity_odd_i"];
    "in:s_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="s_*\ns_tdata\ns_tvalid"];
    "in:stop2_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="stop2_i"];
    "in:tick16_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="tick16_i"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:busy_o" "out:s_*" "out:txd_o" }
    "out:busy_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="busy_o"];
    "out:s_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="s_tready"];
    "out:txd_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="txd_o"];
  }
  subgraph cluster_b0 { label="always_ff @ line 46"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:bitn" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="bitn\n[2:0]"];
    "sig:par" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="par"];
    "sig:sh" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="sh\n[7:0]"];
    "sig:state" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="state\n[2:0]"];
    "sig:tcnt" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="tcnt\n[3:0]"];
  }
  "sig:bit_end" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="bit_end"];
  "in:data_bits_i" -> "out:txd_o";
  "in:data_bits_i" -> "sig:state";
  "in:en_i" -> "out:s_*";
  "in:en_i" -> "out:txd_o";
  "in:en_i" -> "sig:bitn";
  "in:en_i" -> "sig:par";
  "in:en_i" -> "sig:sh";
  "in:en_i" -> "sig:state";
  "in:en_i" -> "sig:tcnt";
  "in:parity_en_i" -> "out:txd_o";
  "in:parity_en_i" -> "sig:state";
  "in:parity_odd_i" -> "out:txd_o";
  "in:s_*" -> "out:txd_o";
  "in:s_*" -> "sig:bitn";
  "in:s_*" -> "sig:par";
  "in:s_*" -> "sig:sh";
  "in:s_*" -> "sig:state";
  "in:s_*" -> "sig:tcnt";
  "in:stop2_i" -> "sig:state";
  "in:tick16_i" -> "sig:bit_end";
  "in:tick16_i" -> "sig:tcnt";
  "sig:bit_end" -> "out:txd_o";
  "sig:bit_end" -> "sig:bitn";
  "sig:bit_end" -> "sig:par";
  "sig:bit_end" -> "sig:sh";
  "sig:bit_end" -> "sig:state";
  "sig:bitn" -> "out:txd_o";
  "sig:bitn" -> "sig:bitn";
  "sig:bitn" -> "sig:state";
  "sig:par" -> "out:txd_o";
  "sig:par" -> "sig:par";
  "sig:sh" -> "out:txd_o";
  "sig:sh" -> "sig:par";
  "sig:sh" -> "sig:sh";
  "sig:state" -> "out:busy_o";
  "sig:state" -> "out:s_*";
  "sig:state" -> "out:txd_o";
  "sig:state" -> "sig:bitn";
  "sig:state" -> "sig:par";
  "sig:state" -> "sig:sh";
  "sig:state" -> "sig:state";
  "sig:state" -> "sig:tcnt";
  "sig:tcnt" -> "sig:bit_end";
  "sig:tcnt" -> "sig:tcnt";
}
