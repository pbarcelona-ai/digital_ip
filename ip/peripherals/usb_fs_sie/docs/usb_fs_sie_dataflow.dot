  "inst:u_rx" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>usb_fs_rx</B><BR/><FONT COLOR="#4b5563">u_rx</FONT>>];
  "inst:u_rxf" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>usb_axis_fifo</B><BR/><FONT COLOR="#4b5563">u_rxf</FONT>>];
  "inst:u_txf" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>usb_axis_fifo</B><BR/><FONT COLOR="#4b5563">u_txf</FONT>>];
  "inst:u_tx" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>usb_fs_tx</B><BR/><FONT COLOR="#4b5563">u_tx</FONT>>];
