  "sig:regs" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="regs\n[6*32-1:0]"];
  "sig:rx_active" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="rx_active\n[31:0]"];
  "sig:rx_bad" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="rx_bad"];
