digraph "usb_fs_sie_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>usb_fs_sie_top</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/peripherals/usb_fs_sie/src/usb_fs_sie_top.sv; clocks / resets (not drawn): aclk, aresetn<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:s_axil_*" "in:s_axis_*" "in:usb_dm_i" "in:usb_dp_i" }
    "in:s_axil_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="s_axil_*\ns_axil_awaddr\ns_axil_awvalid\ns_axil_wdata\ns_axil_wstrb\ns_axil_wvalid\ns_axil_bready\ns_axil_araddr\ns_axil_arvalid\ns_axil_rready"];
    "in:s_axis_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="s_axis_*\ns_axis_tdata\ns_axis_tvalid\ns_axis_tlast"];
    "in:usb_dm_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="usb_dm_i"];
    "in:usb_dp_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="usb_dp_i"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:m_axis_*" "out:s_axis_*" "out:usb_dm_o" "out:usb_dp_o" "out:usb_oe_o" "out:usb_pullup_o" }
    "out:m_axis_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="m_axis_*\nm_axis_tdata\nm_axis_tvalid\nm_axis_tlast\nm_axis_tuser"];
    "out:s_axis_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="s_axis_tready"];
    "out:usb_dm_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="usb_dm_o"];
    "out:usb_dp_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="usb_dp_o"];
    "out:usb_oe_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="usb_oe_o"];
    "out:usb_pullup_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="usb_pullup_o"];
  }
  subgraph cluster_b0 { label="always_ff @ line 124"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:pkts" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="pkts\n[15:0]"];
  }
  subgraph cluster_b1 { label="always_ff @ line 139"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:c_bad" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="c_bad\n[31:0]"];
    "sig:c_good" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="c_good\n[31:0]"];
    "sig:c_tx" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="c_tx\n[31:0]"];
    "sig:f_ovf" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="f_ovf\n[31:0]"];
    "sig:f_reset" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="f_reset"];
  }
  "sig:enable" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="enable"];
  "sig:line" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="line\n[31:0]"];
  "sig:rd" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="rd\n[6*32-1:0]"];
