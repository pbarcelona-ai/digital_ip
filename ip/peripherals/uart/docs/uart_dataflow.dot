digraph "uart_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>uart_top</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/peripherals/uart/src/uart_top.sv; clocks / resets (not drawn): aclk, aresetn<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:s_axil_*" "in:s_axis_*" "in:uart_rxd_i" }
    "in:s_axil_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="s_axil_*\ns_axil_awaddr\ns_axil_awvalid\ns_axil_wdata\ns_axil_wstrb\ns_axil_wvalid\ns_axil_bready\ns_axil_araddr\ns_axil_arvalid\ns_axil_rready"];
    "in:s_axis_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="s_axis_*\ns_axis_tdata\ns_axis_tvalid\ns_axis_tlast"];
    "in:uart_rxd_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="uart_rxd_i"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:m_axis_*" "out:s_axil_*" "out:uart_txd_o" }
    "out:m_axis_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="m_axis_*\nm_axis_tdata\nm_axis_tvalid\nm_axis_tlast"];
    "out:s_axil_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="s_axil_*\ns_axil_awready\ns_axil_wready\ns_axil_bresp\ns_axil_bvalid\ns_axil_arready\ns_axil_rdata\ns_axil_rresp\ns_axil_rvalid"];
    "out:uart_txd_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="uart_txd_o"];
  }
  subgraph cluster_b0 { label="always @ line 67"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:ip_chk_b_q" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="ip_chk_b_q"];
    "sig:ip_chk_r_q" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="ip_chk_r_q"];
  }
  subgraph cluster_b1 { label="always_ff @ line 151"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:err_cnt" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="err_cnt\n[31:0]"];
    "sig:frame_err" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="frame_err\n[31:0]"];
    "sig:overrun" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="overrun\n[31:0]"];
    "sig:parity_err" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="parity_err\n[31:0]"];
  }
  "sig:data_bits" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="data_bits\n[3:0]"];
  "sig:loopback" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="loopback"];
  "sig:par_en" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="par_en"];
  "sig:par_odd" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="par_odd"];
  "sig:rd" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="rd\n[4*32-1:0]"];
  "sig:regs" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="regs\n[4*32-1:0]"];
  "sig:rx_busy" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="rx_busy\n[31:0]"];
  "sig:rx_data" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="rx_data\n[7:0]"];
  "sig:rx_en" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="rx_en"];
  "sig:rx_ferr" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="rx_ferr"];
  "sig:rx_perr" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="rx_perr"];
  "sig:rx_valid" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="rx_valid"];
  "sig:rxd_in" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="rxd_in"];
  "sig:rxf_last" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="rxf_last"];
  "sig:rxf_level" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="rxf_level\n[LW-1:0]"];
  "sig:rxf_ready" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="rxf_ready"];
  "sig:rxf_user" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="rxf_user"];
  "sig:status" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="status\n[31:0]"];
  "sig:stop2" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="stop2"];
  "sig:tick16" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="tick16"];
  "sig:tx_busy" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="tx_busy"];
  "sig:tx_en" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="tx_en"];
  "sig:txd" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="txd"];
  "sig:txf_last" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="txf_last"];
  "sig:txf_level" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="txf_level\n[LW-1:0]"];
  "sig:txf_user" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="txf_user"];
  "sig:wr_data" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="wr_data\n[31:0]"];
  "sig:wr_pulse" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="wr_pulse\n[3:0]"];
  "inst:u_regs" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>ip_axil_regs</B><BR/><FONT COLOR="#4b5563">u_regs</FONT>>];
  "inst:u_baud" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>uart_baud</B><BR/><FONT COLOR="#4b5563">u_baud</FONT>>];
  "inst:u_txf" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>ip_axis_fifo</B><BR/><FONT COLOR="#4b5563">u_txf</FONT>>];
  "inst:u_tx" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>uart_tx</B><BR/><FONT COLOR="#4b5563">u_tx</FONT>>];
  "inst:u_rx" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>uart_rx</B><BR/><FONT COLOR="#4b5563">u_rx</FONT>>];
  "inst:u_rxf" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>ip_axis_fifo</B><BR/><FONT COLOR="#4b5563">u_rxf</FONT>>];
  "in:s_axil_*" -> "sig:ip_chk_b_q";
  "in:s_axil_*" -> "sig:ip_chk_r_q";
  "in:uart_rxd_i" -> "sig:rxd_in";
  "inst:u_baud" -> "sig:tick16";
  "inst:u_regs" -> "out:s_axil_*";
  "inst:u_regs" -> "sig:regs";
  "inst:u_regs" -> "sig:wr_data";
  "inst:u_regs" -> "sig:wr_pulse";
  "inst:u_rx" -> "sig:rx_busy";
  "inst:u_rx" -> "sig:rx_data";
  "inst:u_rx" -> "sig:rx_ferr";
  "inst:u_rx" -> "sig:rx_perr";
  "inst:u_rx" -> "sig:rx_valid";
  "inst:u_rxf" -> "out:m_axis_*";
  "inst:u_rxf" -> "sig:rxf_last";
  "inst:u_rxf" -> "sig:rxf_level";
  "inst:u_rxf" -> "sig:rxf_ready";
  "inst:u_rxf" -> "sig:rxf_user";
  "inst:u_tx" -> "sig:tx_busy";
  "inst:u_tx" -> "sig:txd";
  "inst:u_txf" -> "sig:txf_last";
  "inst:u_txf" -> "sig:txf_level";
  "inst:u_txf" -> "sig:txf_user";
  "out:m_axis_*" -> "sig:status";
  "out:s_axil_*" -> "sig:ip_chk_b_q";
  "out:s_axil_*" -> "sig:ip_chk_r_q";
  "sig:data_bits" -> "inst:u_rx";
  "sig:data_bits" -> "inst:u_tx";
  "sig:err_cnt" -> "sig:err_cnt";
  "sig:err_cnt" -> "sig:rd";
  "sig:frame_err" -> "sig:status";
  "sig:loopback" -> "sig:rxd_in";
  "sig:overrun" -> "sig:status";
  "sig:par_en" -> "inst:u_rx";
  "sig:par_en" -> "inst:u_tx";
  "sig:par_odd" -> "inst:u_rx";
  "sig:par_odd" -> "inst:u_tx";
  "sig:parity_err" -> "sig:status";
  "sig:rd" -> "inst:u_regs";
  "sig:regs" -> "inst:u_baud";
  "sig:regs" -> "sig:data_bits";
  "sig:regs" -> "sig:loopback";
  "sig:regs" -> "sig:par_en";
  "sig:regs" -> "sig:par_odd";
  "sig:regs" -> "sig:rd";
  "sig:regs" -> "sig:rx_en";
  "sig:regs" -> "sig:stop2";
  "sig:regs" -> "sig:tx_en";
  "sig:rx_busy" -> "sig:status";
  "sig:rx_data" -> "inst:u_rxf";
  "sig:rx_en" -> "inst:u_rx";
  "sig:rx_ferr" -> "inst:u_rxf";
  "sig:rx_ferr" -> "sig:err_cnt";
  "sig:rx_ferr" -> "sig:frame_err";
  "sig:rx_perr" -> "inst:u_rxf";
  "sig:rx_perr" -> "sig:err_cnt";
  "sig:rx_perr" -> "sig:parity_err";
  "sig:rx_valid" -> "inst:u_rxf";
  "sig:rx_valid" -> "sig:err_cnt";
  "sig:rx_valid" -> "sig:frame_err";
  "sig:rx_valid" -> "sig:overrun";
  "sig:rx_valid" -> "sig:parity_err";
  "sig:rxd_in" -> "inst:u_rx";
  "sig:rxf_last" -> "out:m_axis_*";
  "sig:rxf_level" -> "sig:status";
  "sig:rxf_ready" -> "sig:overrun";
  "sig:status" -> "sig:rd";
  "sig:stop2" -> "inst:u_tx";
  "sig:tick16" -> "inst:u_rx";
  "sig:tick16" -> "inst:u_tx";
  "sig:tx_busy" -> "sig:status";
  "sig:tx_en" -> "inst:u_tx";
  "sig:txd" -> "out:uart_txd_o";
  "sig:txd" -> "sig:rxd_in";
  "sig:wr_data" -> "sig:frame_err";
  "sig:wr_data" -> "sig:overrun";
  "sig:wr_data" -> "sig:parity_err";
  "sig:wr_pulse" -> "sig:frame_err";
  "sig:wr_pulse" -> "sig:overrun";
  "sig:wr_pulse" -> "sig:parity_err";
  "inst:u_txf" -> "inst:u_tx" [penwidth=3.2, color="#0f766e", fontcolor="#0f766e", fontname="Courier", fontsize=9, label="AXI4-Stream
txf_* (3)"];
  "inst:u_rxf" -> "out:m_axis_*" [penwidth=3.2, color="#0f766e", fontcolor="#0f766e", fontname="Courier", fontsize=9, label="AXI4-Stream
m_axis_t* (3)"];
  "in:s_axil_*" -> "inst:u_regs" [penwidth=3.2, color="#0f766e", fontcolor="#0f766e", fontname="Courier", fontsize=9, label="AXI4-Lite
s_axil_* (17)"];
  "in:s_axis_*" -> "inst:u_txf" [penwidth=3.2, color="#0f766e", fontcolor="#0f766e", fontname="Courier", fontsize=9, label="AXI4-Stream
s_axis_t* (4)"];
}
