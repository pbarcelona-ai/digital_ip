digraph "i2s_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>i2s</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/peripherals/i2s/src/i2s.sv; clocks / resets (not drawn): clk, rst_n<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:bclk_half_i" "in:en_i" "in:sd_i" "in:tx_left_i" "in:tx_right_i" "in:tx_valid_i" }
    "in:bclk_half_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="bclk_half_i\n[7:0]"];
    "in:en_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="en_i"];
    "in:sd_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="sd_i"];
    "in:tx_left_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="tx_left_i\n[WORD_W-1:0]"];
    "in:tx_right_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="tx_right_i\n[WORD_W-1:0]"];
    "in:tx_valid_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="tx_valid_i"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:bclk_o" "out:lrck_o" "out:rx_left_o" "out:rx_right_o" "out:rx_valid_o" "out:sd_o" "out:tx_ready_o" "out:underrun_o" }
    "out:bclk_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="bclk_o"];
    "out:lrck_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="lrck_o"];
    "out:rx_left_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="rx_left_o\n[WORD_W-1:0]"];
    "out:rx_right_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="rx_right_o\n[WORD_W-1:0]"];
    "out:rx_valid_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="rx_valid_o"];
    "out:sd_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="sd_o"];
    "out:tx_ready_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="tx_ready_o"];
    "out:underrun_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="underrun_o"];
  }
  subgraph cluster_b0 { label="always_comb @ line 58"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:bit_now" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="bit_now"];
  }
  subgraph cluster_b1 { label="always_ff @ line 65"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:hc" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="hc\n[7:0]"];
    "sig:nq" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="nq\n[PW-1:0]"];
    "sig:pos" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="pos\n[PW-1:0]"];
    "sig:rxl" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="rxl\n[WORD_W-1:0]"];
    "sig:rxr" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="rxr\n[WORD_W-1:0]"];
    "sig:synced" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="synced"];
    "sig:txl" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="txl\n[WORD_W-1:0]"];
    "sig:txr" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="txr\n[WORD_W-1:0]"];
  }
  "sig:fall" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="fall"];
  "sig:half" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="half\n[7:0]"];
  "sig:last_pos" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="last_pos"];
  "sig:rise" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="rise"];
  "sig:toggle" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="toggle"];
  "sig:wm1" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="wm1\n[PW-1:0]"];
  "const:wm1" [shape=plaintext, fontcolor="#6b7280", fontsize=8, label="constant"];
  "const:wm1" -> "sig:wm1";
  "in:bclk_half_i" -> "sig:half";
  "in:en_i" -> "out:bclk_o";
  "in:en_i" -> "out:lrck_o";
  "in:en_i" -> "out:rx_left_o";
  "in:en_i" -> "out:rx_right_o";
  "in:en_i" -> "out:rx_valid_o";
  "in:en_i" -> "out:sd_o";
  "in:en_i" -> "out:tx_ready_o";
  "in:en_i" -> "out:underrun_o";
  "in:en_i" -> "sig:hc";
  "in:en_i" -> "sig:nq";
  "in:en_i" -> "sig:pos";
  "in:en_i" -> "sig:rxl";
  "in:en_i" -> "sig:rxr";
  "in:en_i" -> "sig:synced";
  "in:en_i" -> "sig:txl";
  "in:en_i" -> "sig:txr";
  "in:sd_i" -> "out:rx_right_o";
  "in:sd_i" -> "sig:rxl";
  "in:sd_i" -> "sig:rxr";
  "in:tx_left_i" -> "sig:txl";
  "in:tx_right_i" -> "sig:txr";
  "in:tx_valid_i" -> "out:tx_ready_o";
  "in:tx_valid_i" -> "out:underrun_o";
  "in:tx_valid_i" -> "sig:txl";
  "in:tx_valid_i" -> "sig:txr";
  "out:bclk_o" -> "out:bclk_o";
  "out:bclk_o" -> "sig:fall";
  "out:bclk_o" -> "sig:rise";
  "sig:bit_now" -> "out:sd_o";
  "sig:fall" -> "out:lrck_o";
  "sig:fall" -> "out:sd_o";
  "sig:fall" -> "out:tx_ready_o";
  "sig:fall" -> "out:underrun_o";
  "sig:fall" -> "sig:nq";
  "sig:fall" -> "sig:pos";
  "sig:fall" -> "sig:txl";
  "sig:fall" -> "sig:txr";
  "sig:half" -> "sig:toggle";
  "sig:hc" -> "sig:hc";
  "sig:hc" -> "sig:toggle";
  "sig:last_pos" -> "out:lrck_o";
  "sig:last_pos" -> "out:tx_ready_o";
  "sig:last_pos" -> "out:underrun_o";
  "sig:last_pos" -> "sig:pos";
  "sig:last_pos" -> "sig:txl";
  "sig:last_pos" -> "sig:txr";
  "sig:nq" -> "out:rx_left_o";
  "sig:nq" -> "out:rx_right_o";
  "sig:nq" -> "out:rx_valid_o";
  "sig:nq" -> "sig:rxl";
  "sig:nq" -> "sig:rxr";
  "sig:nq" -> "sig:synced";
  "sig:pos" -> "out:lrck_o";
  "sig:pos" -> "sig:bit_now";
  "sig:pos" -> "sig:last_pos";
  "sig:pos" -> "sig:nq";
  "sig:pos" -> "sig:pos";
  "sig:rise" -> "out:rx_left_o";
  "sig:rise" -> "out:rx_right_o";
  "sig:rise" -> "out:rx_valid_o";
  "sig:rise" -> "sig:rxl";
  "sig:rise" -> "sig:rxr";
  "sig:rise" -> "sig:synced";
  "sig:rxl" -> "out:rx_left_o";
  "sig:rxl" -> "sig:rxl";
  "sig:rxr" -> "out:rx_right_o";
  "sig:rxr" -> "sig:rxr";
  "sig:synced" -> "out:rx_left_o";
  "sig:synced" -> "out:rx_right_o";
  "sig:synced" -> "out:rx_valid_o";
  "sig:toggle" -> "out:bclk_o";
  "sig:toggle" -> "sig:fall";
  "sig:toggle" -> "sig:hc";
  "sig:toggle" -> "sig:rise";
  "sig:txl" -> "sig:bit_now";
  "sig:txr" -> "sig:bit_now";
  "sig:wm1" -> "out:lrck_o";
}
