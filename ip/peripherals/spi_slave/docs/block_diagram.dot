digraph "spi_slave" {
  graph [rankdir=LR, bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.65, label="spi_slave RTL hierarchy", labelloc=t, fontname="Helvetica", fontsize=16];
  node [shape=box, fontname="Helvetica", fontsize=10, margin="0.14,0.08"];
  edge [color="#52635c", arrowsize=0.7];
  n0 [label="spi_slave\n(top)", style="rounded,filled", fillcolor="#dcefe8", color="#176b59"];
  n1 [label="bit_sync\n(u_cs)", style="rounded,filled", fillcolor="#f4f6f5", color="#71817a"];
  n2 [label="bit_sync\n(u_sclk)", style="rounded,filled", fillcolor="#f4f6f5", color="#71817a"];
  n3 [label="bit_sync\n(u_mosi)", style="rounded,filled", fillcolor="#f4f6f5", color="#71817a"];
  n0 -> n1;
  n0 -> n2;
  n0 -> n3;
}
