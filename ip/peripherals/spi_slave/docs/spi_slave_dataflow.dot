digraph "spi_slave_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>spi_slave</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/peripherals/spi_slave/src/spi_slave.sv; clocks / resets (not drawn): clk, rst_n, sclk_i<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:cs_n_i" "in:mosi_i" "in:tx_data_i" "in:tx_valid_i" }
    "in:cs_n_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="cs_n_i"];
    "in:mosi_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="mosi_i"];
    "in:tx_data_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="tx_data_i\n[WORD_BITS-1:0]"];
    "in:tx_valid_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="tx_valid_i"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:active_o" "out:frame_end_o" "out:frame_err_o" "out:miso_o" "out:miso_oe_o" "out:rx_data_o" "out:rx_valid_o" "out:tx_ready_o" "out:underrun_o" }
    "out:active_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="active_o"];
    "out:frame_end_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="frame_end_o"];
    "out:frame_err_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="frame_err_o"];
    "out:miso_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="miso_o"];
    "out:miso_oe_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="miso_oe_o"];
    "out:rx_data_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="rx_data_o\n[WORD_BITS-1:0]"];
    "out:rx_valid_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="rx_valid_o"];
    "out:tx_ready_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="tx_ready_o"];
    "out:underrun_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="underrun_o"];
  }
  subgraph cluster_b0 { label="always_ff @ line 55"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:cs_d" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="cs_d"];
    "sig:sclk_d" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="sclk_d"];
  }
  subgraph cluster_b1 { label="always_ff @ line 73"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:miso_r" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="miso_r"];
    "sig:rx_sr" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="rx_sr\n[WORD_BITS-1:0]"];
    "sig:scnt" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="scnt\n[CW-1:0]"];
    "sig:tx_word" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="tx_word\n[WORD_BITS-1:0]"];
  }
  "sig:cs_fall" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="cs_fall"];
  "sig:cs_rise" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="cs_rise"];
  "sig:cs_s" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="cs_s"];
  "sig:lead" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="lead"];
  "sig:mosi_s" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="mosi_s"];
  "sig:sample" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="sample"];
  "sig:sclk_s" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="sclk_s"];
  "sig:shift" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="shift"];
  "sig:trail" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="trail"];
  "inst:u_cs" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>bit_sync</B><BR/><FONT COLOR="#4b5563">u_cs</FONT>>];
  "inst:u_sclk" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>bit_sync</B><BR/><FONT COLOR="#4b5563">u_sclk</FONT>>];
  "inst:u_mosi" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>bit_sync</B><BR/><FONT COLOR="#4b5563">u_mosi</FONT>>];
  "in:cs_n_i" -> "inst:u_cs";
  "in:mosi_i" -> "inst:u_mosi";
  "in:tx_data_i" -> "sig:miso_r";
  "in:tx_data_i" -> "sig:tx_word";
  "in:tx_valid_i" -> "out:tx_ready_o";
  "in:tx_valid_i" -> "out:underrun_o";
  "in:tx_valid_i" -> "sig:miso_r";
  "in:tx_valid_i" -> "sig:tx_word";
  "inst:u_cs" -> "sig:cs_s";
  "inst:u_mosi" -> "sig:mosi_s";
  "inst:u_sclk" -> "sig:sclk_s";
  "sig:cs_d" -> "sig:cs_fall";
  "sig:cs_d" -> "sig:cs_rise";
  "sig:cs_fall" -> "out:frame_end_o";
  "sig:cs_fall" -> "out:frame_err_o";
  "sig:cs_fall" -> "out:rx_data_o";
  "sig:cs_fall" -> "out:rx_valid_o";
  "sig:cs_fall" -> "out:tx_ready_o";
  "sig:cs_fall" -> "out:underrun_o";
  "sig:cs_fall" -> "sig:miso_r";
  "sig:cs_fall" -> "sig:rx_sr";
  "sig:cs_fall" -> "sig:scnt";
  "sig:cs_fall" -> "sig:tx_word";
  "sig:cs_rise" -> "out:frame_end_o";
  "sig:cs_rise" -> "out:frame_err_o";
  "sig:cs_rise" -> "out:rx_data_o";
  "sig:cs_rise" -> "out:rx_valid_o";
  "sig:cs_rise" -> "out:tx_ready_o";
  "sig:cs_rise" -> "out:underrun_o";
  "sig:cs_rise" -> "sig:miso_r";
  "sig:cs_rise" -> "sig:rx_sr";
  "sig:cs_rise" -> "sig:scnt";
  "sig:cs_rise" -> "sig:tx_word";
  "sig:cs_s" -> "out:active_o";
  "sig:cs_s" -> "out:miso_oe_o";
  "sig:cs_s" -> "sig:cs_d";
  "sig:cs_s" -> "sig:cs_fall";
  "sig:cs_s" -> "sig:cs_rise";
  "sig:cs_s" -> "sig:lead";
  "sig:cs_s" -> "sig:trail";
  "sig:lead" -> "sig:sample";
  "sig:lead" -> "sig:shift";
  "sig:miso_r" -> "out:miso_o";
  "sig:mosi_s" -> "out:rx_data_o";
  "sig:mosi_s" -> "sig:rx_sr";
  "sig:rx_sr" -> "out:rx_data_o";
  "sig:rx_sr" -> "sig:rx_sr";
  "sig:sample" -> "out:rx_data_o";
  "sig:sample" -> "out:rx_valid_o";
  "sig:sample" -> "out:tx_ready_o";
  "sig:sample" -> "out:underrun_o";
  "sig:sample" -> "sig:rx_sr";
  "sig:sample" -> "sig:scnt";
  "sig:sample" -> "sig:tx_word";
  "sig:sclk_d" -> "sig:lead";
  "sig:sclk_d" -> "sig:trail";
  "sig:sclk_s" -> "sig:lead";
  "sig:sclk_s" -> "sig:sclk_d";
  "sig:sclk_s" -> "sig:trail";
  "sig:scnt" -> "out:frame_err_o";
  "sig:scnt" -> "out:rx_data_o";
  "sig:scnt" -> "out:rx_valid_o";
  "sig:scnt" -> "out:tx_ready_o";
  "sig:scnt" -> "out:underrun_o";
  "sig:scnt" -> "sig:miso_r";
  "sig:scnt" -> "sig:scnt";
  "sig:scnt" -> "sig:tx_word";
  "sig:shift" -> "sig:miso_r";
  "sig:trail" -> "sig:sample";
  "sig:trail" -> "sig:shift";
  "sig:tx_word" -> "sig:miso_r";
}
