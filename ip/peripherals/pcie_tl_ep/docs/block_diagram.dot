digraph "pcie_tl_ep" {
  graph [rankdir=LR, bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.65, label="pcie_tl_ep RTL hierarchy", labelloc=t, fontname="Helvetica", fontsize=16];
  node [shape=box, fontname="Helvetica", fontsize=10, margin="0.14,0.08"];
  edge [color="#52635c", arrowsize=0.7];
  n0 [label="pcie_tl_ep_top\n(top)", style="rounded,filled", fillcolor="#dcefe8", color="#176b59"];
  n1 [label="pcie_axil_regs\n(u_regs)", style="rounded,filled", fillcolor="#f4f6f5", color="#71817a"];
  n2 [label="pcie_axis_to_dw\n(u_rx_conv)", style="rounded,filled", fillcolor="#f4f6f5", color="#71817a"];
  n3 [label="pcie_tl_target\n(u_tgt)", style="rounded,filled", fillcolor="#f4f6f5", color="#71817a"];
  n4 [label="pcie_axis_fifo\n(u_mfifo)", style="rounded,filled", fillcolor="#f4f6f5", color="#71817a"];
  n5 [label="pcie_axis_fifo\n(u_sfifo)", style="rounded,filled", fillcolor="#f4f6f5", color="#71817a"];
  n6 [label="pcie_tl_dma\n(u_dma)", style="rounded,filled", fillcolor="#f4f6f5", color="#71817a"];
  n7 [label="pcie_dw_to_axis\n(u_tx_conv)", style="rounded,filled", fillcolor="#f4f6f5", color="#71817a"];
  n0 -> n1;
  n0 -> n2;
  n0 -> n3;
  n0 -> n4;
  n0 -> n5;
  n0 -> n6;
  n0 -> n7;
}
