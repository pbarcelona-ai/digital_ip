    "in:s_axis_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="s_axis_*\ns_axis_tdata\ns_axis_tlast\ns_axis_tvalid"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:crc_err_o" "out:gmii_tx_en" "out:gmii_tx_er" "out:gmii_txd" "out:m_axis_*" "out:overflow_o" "out:rx_err_o" "out:s_axis_*" "out:short_o" "out:underrun_o" }
    "out:crc_err_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="crc_err_o"];
    "out:gmii_tx_en" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="gmii_tx_en"];
