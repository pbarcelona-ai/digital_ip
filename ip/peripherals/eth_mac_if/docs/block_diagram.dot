digraph "eth_mac_if" {
  graph [rankdir=LR, bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.65, label="eth_mac_if RTL hierarchy", labelloc=t, fontname="Helvetica", fontsize=16];
  node [shape=box, fontname="Helvetica", fontsize=10, margin="0.14,0.08"];
  edge [color="#52635c", arrowsize=0.7];
  n0 [label="eth_mac_if\n(top)", style="rounded,filled", fillcolor="#dcefe8", color="#176b59"];
  n1 [label="crc32\n(u_tcrc)", style="rounded,filled", fillcolor="#f4f6f5", color="#71817a"];
  n2 [label="crc_core\n(u_core)", style="rounded,filled", fillcolor="#f4f6f5", color="#71817a"];
  n3 [label="crc32\n(u_rcrc)", style="rounded,filled", fillcolor="#f4f6f5", color="#71817a"];
  n4 [label="crc_core\n(u_core)", style="rounded,filled", fillcolor="#f4f6f5", color="#71817a"];
  n0 -> n1;
  n1 -> n2;
  n0 -> n3;
  n3 -> n4;
}
