digraph "uart_rx_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>uart_rx</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/peripherals/uart/src/uart_rx.sv; clocks / resets (not drawn): clk, rst_n<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:data_bits_i" "in:en_i" "in:parity_en_i" "in:parity_odd_i" "in:rxd_i" "in:tick16_i" }
    "in:data_bits_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="data_bits_i\n[3:0]"];
    "in:en_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="en_i"];
    "in:parity_en_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="parity_en_i"];
    "in:parity_odd_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="parity_odd_i"];
    "in:rxd_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="rxd_i"];
    "in:tick16_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="tick16_i"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:busy_o" "out:data_o" "out:frame_err_o" "out:parity_err_o" "out:valid_o" }
    "out:busy_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="busy_o"];
    "out:data_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="data_o\n[7:0]"];
    "out:frame_err_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="frame_err_o"];
    "out:parity_err_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="parity_err_o"];
    "out:valid_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="valid_o"];
  }
  subgraph cluster_b0 { label="always_ff @ line 44"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:rxs" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="rxs"];
    "sig:sync_q" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="sync_q\n[1:0]"];
  }
  subgraph cluster_b1 { label="always_ff @ line 53"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:armed" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="armed"];
    "sig:bitn" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="bitn\n[2:0]"];
    "sig:par" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="par"];
    "sig:perr" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="perr"];
    "sig:state" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="state\n[2:0]"];
    "sig:tcnt" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="tcnt\n[3:0]"];
    "sig:word" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="word\n[7:0]"];
  }
  "in:data_bits_i" -> "sig:state";
  "in:en_i" -> "sig:armed";
  "in:en_i" -> "sig:state";
  "in:parity_en_i" -> "out:parity_err_o";
  "in:parity_en_i" -> "sig:state";
  "in:parity_odd_i" -> "sig:perr";
  "in:rxd_i" -> "sig:sync_q";
  "in:tick16_i" -> "out:data_o";
  "in:tick16_i" -> "out:frame_err_o";
  "in:tick16_i" -> "out:parity_err_o";
  "in:tick16_i" -> "out:valid_o";
  "in:tick16_i" -> "sig:bitn";
  "in:tick16_i" -> "sig:par";
  "in:tick16_i" -> "sig:perr";
  "in:tick16_i" -> "sig:state";
  "in:tick16_i" -> "sig:tcnt";
  "in:tick16_i" -> "sig:word";
  "sig:armed" -> "sig:armed";
  "sig:armed" -> "sig:state";
  "sig:bitn" -> "sig:bitn";
  "sig:bitn" -> "sig:state";
  "sig:bitn" -> "sig:word";
  "sig:par" -> "sig:par";
  "sig:par" -> "sig:perr";
  "sig:perr" -> "out:parity_err_o";
  "sig:rxs" -> "out:frame_err_o";
  "sig:rxs" -> "sig:armed";
  "sig:rxs" -> "sig:bitn";
  "sig:rxs" -> "sig:par";
  "sig:rxs" -> "sig:perr";
  "sig:rxs" -> "sig:state";
  "sig:rxs" -> "sig:word";
  "sig:state" -> "out:busy_o";
  "sig:state" -> "out:data_o";
  "sig:state" -> "out:frame_err_o";
  "sig:state" -> "out:parity_err_o";
  "sig:state" -> "out:valid_o";
  "sig:state" -> "sig:armed";
  "sig:state" -> "sig:bitn";
  "sig:state" -> "sig:par";
  "sig:state" -> "sig:perr";
  "sig:state" -> "sig:state";
  "sig:state" -> "sig:tcnt";
  "sig:state" -> "sig:word";
  "sig:sync_q" -> "sig:rxs";
  "sig:sync_q" -> "sig:sync_q";
  "sig:tcnt" -> "out:data_o";
  "sig:tcnt" -> "out:frame_err_o";
  "sig:tcnt" -> "out:parity_err_o";
  "sig:tcnt" -> "out:valid_o";
  "sig:tcnt" -> "sig:bitn";
  "sig:tcnt" -> "sig:par";
  "sig:tcnt" -> "sig:perr";
  "sig:tcnt" -> "sig:state";
  "sig:tcnt" -> "sig:tcnt";
  "sig:tcnt" -> "sig:word";
  "sig:word" -> "out:data_o";
}
