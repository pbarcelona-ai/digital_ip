digraph "intc_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>intc_top</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/peripherals/intc/src/intc_top.sv; clocks / resets (not drawn): aclk, aresetn<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:irq_i" "in:s_axil_*" }
    "in:irq_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="irq_i\n[NUM_IRQ-1:0]"];
    "in:s_axil_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="s_axil_*\ns_axil_awaddr\ns_axil_awvalid\ns_axil_wdata\ns_axil_wstrb\ns_axil_wvalid\ns_axil_bready\ns_axil_araddr\ns_axil_arvalid\ns_axil_rready"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:irq_o" "out:s_axil_*" }
    "out:irq_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="irq_o"];
    "out:s_axil_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="s_axil_*\ns_axil_awready\ns_axil_wready\ns_axil_bresp\ns_axil_bvalid\ns_axil_arready\ns_axil_rdata\ns_axil_rresp\ns_axil_rvalid"];
  }
  subgraph cluster_b0 { label="always @ line 52"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:ip_chk_b_q" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="ip_chk_b_q"];
    "sig:ip_chk_r_q" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="ip_chk_r_q"];
  }
  subgraph cluster_b1 { label="always_ff @ line 79"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:lvl" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="lvl\n[NUM_IRQ-1:0]"];
    "sig:prev" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="prev\n[NUM_IRQ-1:0]"];
    "sig:s1" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="s1\n[NUM_IRQ-1:0]"];
    "sig:s2" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="s2\n[NUM_IRQ-1:0]"];
  }
  subgraph cluster_b2 { label="always_ff @ line 87"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:pend_edge" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="pend_edge\n[NUM_IRQ-1:0]"];
  }
  subgraph cluster_b3 { label="always_ff @ line 98"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:vec" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="vec\n[4:0]"];
    "sig:vec_v" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="vec_v"];
  }
  "sig:edg" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="edg\n[NUM_IRQ-1:0]"];
  "sig:en" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="en\n[NUM_IRQ-1:0]"];
  "sig:masked" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="masked\n[NUM_IRQ-1:0]"];
  "sig:pending" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="pending\n[NUM_IRQ-1:0]"];
  "sig:pol" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="pol\n[NUM_IRQ-1:0]"];
  "sig:rd" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="rd\n[7*32-1:0]"];
  "sig:regs" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="regs\n[7*32-1:0]"];
  "sig:rise" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="rise\n[NUM_IRQ-1:0]"];
  "sig:wd" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="wd\n[NUM_IRQ-1:0]"];
  "sig:wr_data" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="wr_data\n[31:0]"];
  "sig:wr_pulse" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="wr_pulse\n[6:0]"];
  "inst:u_regs" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>ip_axil_regs</B><BR/><FONT COLOR="#4b5563">u_regs</FONT>>];
  "in:irq_i" -> "sig:s1";
  "in:s_axil_*" -> "sig:ip_chk_b_q";
  "in:s_axil_*" -> "sig:ip_chk_r_q";
  "inst:u_regs" -> "out:s_axil_*";
  "inst:u_regs" -> "sig:regs";
  "inst:u_regs" -> "sig:wr_data";
  "inst:u_regs" -> "sig:wr_pulse";
  "out:s_axil_*" -> "sig:ip_chk_b_q";
  "out:s_axil_*" -> "sig:ip_chk_r_q";
  "sig:edg" -> "sig:pend_edge";
  "sig:edg" -> "sig:pending";
  "sig:en" -> "sig:masked";
  "sig:lvl" -> "sig:pending";
  "sig:lvl" -> "sig:prev";
  "sig:lvl" -> "sig:rise";
  "sig:masked" -> "sig:rd";
  "sig:masked" -> "sig:vec";
  "sig:masked" -> "sig:vec_v";
  "sig:pend_edge" -> "sig:pend_edge";
  "sig:pend_edge" -> "sig:pending";
  "sig:pending" -> "sig:masked";
  "sig:pending" -> "sig:rd";
  "sig:pol" -> "sig:lvl";
  "sig:prev" -> "sig:rise";
  "sig:rd" -> "inst:u_regs";
  "sig:regs" -> "sig:edg";
  "sig:regs" -> "sig:en";
  "sig:regs" -> "sig:pol";
  "sig:regs" -> "sig:rd";
  "sig:rise" -> "sig:pend_edge";
  "sig:s1" -> "sig:s2";
  "sig:s2" -> "sig:lvl";
  "sig:vec" -> "sig:rd";
  "sig:vec_v" -> "out:irq_o";
  "sig:vec_v" -> "sig:rd";
  "sig:wd" -> "sig:pend_edge";
  "sig:wr_data" -> "sig:wd";
  "sig:wr_pulse" -> "sig:pend_edge";
  "in:s_axil_*" -> "inst:u_regs" [penwidth=3.2, color="#0f766e", fontcolor="#0f766e", fontname="Courier", fontsize=9, label="AXI4-Lite
s_axil_* (17)"];
}
