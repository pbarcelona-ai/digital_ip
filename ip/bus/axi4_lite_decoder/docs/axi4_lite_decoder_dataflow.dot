digraph "axi4_lite_decoder_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>axi4_lite_decoder</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/bus/axi4_lite_decoder/src/axi4_lite_decoder.sv<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:addr_i" }
    "in:addr_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="addr_i\n[ADDR_W-1:0]"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:miss_o" "out:multi_o" "out:sel_o" }
    "out:miss_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="miss_o"];
    "out:multi_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="multi_o"];
    "out:sel_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="sel_o\n[NSLAVE-1:0]"];
  }
  subgraph cluster_b0 { label="always_comb @ line 40"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:hit" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="hit\n[NSLAVE-1:0]"];
  }
  "in:addr_i" -> "sig:hit";
  "sig:hit" -> "out:miss_o";
  "sig:hit" -> "out:multi_o";
  "sig:hit" -> "out:sel_o";
}
