digraph "axis_dma_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>axis_dma</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/bus/axis_dma/src/axis_dma.sv; clocks / resets (not drawn): aclk, aresetn<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:s_axil_*" "in:s_axis_*" }
    "in:s_axil_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="s_axil_*\ns_axil_awaddr\ns_axil_awvalid\ns_axil_wdata\ns_axil_wstrb\ns_axil_wvalid\ns_axil_bready\ns_axil_araddr\ns_axil_arvalid\ns_axil_rready"];
    "in:s_axis_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="s_axis_*\ns_axis_tdata\ns_axis_tvalid\ns_axis_tlast"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:irq_o" "out:m_axi_*" "out:m_axis_*" "out:s_axil_*" }
    "out:irq_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="irq_o"];
    "out:m_axi_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="m_axi_*\nm_axi_awaddr\nm_axi_awlen\nm_axi_awsize\nm_axi_awburst\nm_axi_awvalid\nm_axi_wdata\nm_axi_wstrb\nm_axi_wlast\nm_axi_wvalid\nm_axi_bready\nm_axi_araddr\nm_axi_arlen\nm_axi_arsize\nm_axi_arburst\nm_axi_arvalid\nm_axi_rready"];
    "out:m_axis_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="m_axis_*\nm_axis_tdata\nm_axis_tvalid\nm_axis_tlast"];
    "out:s_axil_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="s_axil_*\ns_axil_awready\ns_axil_wready\ns_axil_bresp\ns_axil_bvalid\ns_axil_arready\ns_axil_rdata\ns_axil_rresp\ns_axil_rvalid"];
  }
  subgraph cluster_b0 { label="always @ line 93"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:ip_chk_b_q" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="ip_chk_b_q"];
    "sig:ip_chk_r_q" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="ip_chk_r_q"];
  }
  subgraph cluster_b1 { label="always_ff @ line 117"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:mm_done_f" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="mm_done_f"];
    "sig:mm_err_f" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="mm_err_f"];
    "sig:mm_go" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="mm_go"];
    "sig:s2_done_f" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="s2_done_f"];
    "sig:s2_err_f" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="s2_err_f"];
    "sig:s2_go" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="s2_go"];
  }
  "sig:l1" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="l1\n[$clog2(FIFO_DEPTH)+1:0]"];
  "sig:l2" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="l2\n[$clog2(FIFO_DEPTH)+1:0]"];
  "sig:mm_addr" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="mm_addr\n[31:0]"];
  "sig:mm_len" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="mm_len\n[31:0]"];
  "sig:mm_ok" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="mm_ok"];
  "sig:mu" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="mu"];
  "sig:rd" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="rd\n[6*32-1:0]"];
  "sig:rd_busy" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="rd_busy"];
  "sig:rd_done" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="rd_done"];
  "sig:rd_err" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="rd_err"];
  "sig:regs" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="regs\n[6*32-1:0]"];
  "sig:s2_addr" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="s2_addr\n[31:0]"];
  "sig:s2_len" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="s2_len\n[31:0]"];
  "sig:s2_ok" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="s2_ok"];
  "sig:su" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="su"];
  "sig:wr_busy" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="wr_busy"];
  "sig:wr_data" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="wr_data\n[31:0]"];
  "sig:wr_done" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="wr_done"];
  "sig:wr_err" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="wr_err"];
  "sig:wr_pulse" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="wr_pulse\n[5:0]"];
  "sig:wr_tl" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="wr_tl"];
  "inst:u_regs" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>ip_axil_regs</B><BR/><FONT COLOR="#4b5563">u_regs</FONT>>];
  "inst:u_rd" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>dma_rd_engine</B><BR/><FONT COLOR="#4b5563">u_rd</FONT>>];
  "inst:u_mm_fifo" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>ip_axis_fifo</B><BR/><FONT COLOR="#4b5563">u_mm_fifo</FONT>>];
  "inst:u_s2_fifo" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>ip_axis_fifo</B><BR/><FONT COLOR="#4b5563">u_s2_fifo</FONT>>];
  "inst:u_wr" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>dma_wr_engine</B><BR/><FONT COLOR="#4b5563">u_wr</FONT>>];
  "in:s_axil_*" -> "sig:ip_chk_b_q";
  "in:s_axil_*" -> "sig:ip_chk_r_q";
  "inst:u_mm_fifo" -> "sig:l1";
  "inst:u_mm_fifo" -> "sig:mu";
  "inst:u_rd" -> "sig:rd_busy";
  "inst:u_rd" -> "sig:rd_done";
  "inst:u_rd" -> "sig:rd_err";
  "inst:u_regs" -> "out:s_axil_*";
  "inst:u_regs" -> "sig:regs";
  "inst:u_regs" -> "sig:wr_data";
  "inst:u_regs" -> "sig:wr_pulse";
  "inst:u_s2_fifo" -> "sig:l2";
  "inst:u_s2_fifo" -> "sig:su";
  "inst:u_s2_fifo" -> "sig:wr_tl";
  "inst:u_wr" -> "sig:wr_busy";
  "inst:u_wr" -> "sig:wr_done";
  "inst:u_wr" -> "sig:wr_err";
  "out:s_axil_*" -> "sig:ip_chk_b_q";
  "out:s_axil_*" -> "sig:ip_chk_r_q";
  "sig:mm_addr" -> "inst:u_rd";
  "sig:mm_done_f" -> "out:irq_o";
  "sig:mm_done_f" -> "sig:rd";
  "sig:mm_err_f" -> "sig:rd";
  "sig:mm_go" -> "inst:u_rd";
  "sig:mm_len" -> "inst:u_rd";
  "sig:mm_len" -> "sig:mm_ok";
  "sig:mm_ok" -> "sig:mm_err_f";
  "sig:mm_ok" -> "sig:mm_go";
  "sig:rd" -> "inst:u_regs";
  "sig:rd_busy" -> "sig:mm_err_f";
  "sig:rd_busy" -> "sig:mm_go";
  "sig:rd_busy" -> "sig:rd";
  "sig:rd_done" -> "sig:mm_done_f";
  "sig:rd_done" -> "sig:mm_err_f";
  "sig:rd_err" -> "sig:mm_err_f";
  "sig:regs" -> "out:irq_o";
  "sig:regs" -> "sig:mm_addr";
  "sig:regs" -> "sig:mm_len";
  "sig:regs" -> "sig:rd";
  "sig:regs" -> "sig:s2_addr";
  "sig:regs" -> "sig:s2_len";
  "sig:s2_addr" -> "inst:u_wr";
  "sig:s2_done_f" -> "out:irq_o";
  "sig:s2_done_f" -> "sig:rd";
  "sig:s2_err_f" -> "sig:rd";
  "sig:s2_go" -> "inst:u_wr";
  "sig:s2_len" -> "inst:u_wr";
  "sig:s2_len" -> "sig:s2_ok";
  "sig:s2_ok" -> "sig:s2_err_f";
  "sig:s2_ok" -> "sig:s2_go";
  "sig:wr_busy" -> "sig:rd";
  "sig:wr_busy" -> "sig:s2_err_f";
  "sig:wr_busy" -> "sig:s2_go";
  "sig:wr_data" -> "sig:mm_done_f";
  "sig:wr_data" -> "sig:mm_err_f";
  "sig:wr_data" -> "sig:mm_go";
  "sig:wr_data" -> "sig:s2_done_f";
  "sig:wr_data" -> "sig:s2_err_f";
  "sig:wr_data" -> "sig:s2_go";
  "sig:wr_done" -> "sig:s2_done_f";
  "sig:wr_done" -> "sig:s2_err_f";
  "sig:wr_err" -> "sig:s2_err_f";
  "sig:wr_pulse" -> "sig:mm_done_f";
  "sig:wr_pulse" -> "sig:mm_err_f";
  "sig:wr_pulse" -> "sig:mm_go";
  "sig:wr_pulse" -> "sig:s2_done_f";
  "sig:wr_pulse" -> "sig:s2_err_f";
  "sig:wr_pulse" -> "sig:s2_go";
  "inst:u_rd" -> "out:m_axi_*" [penwidth=3.2, color="#0f766e", fontcolor="#0f766e", fontname="Courier", fontsize=9, label="AXI4
m_axi_* (11)"];
  "inst:u_rd" -> "inst:u_mm_fifo" [penwidth=3.2, color="#0f766e", fontcolor="#0f766e", fontname="Courier", fontsize=9, label="AXI4-Stream
rd_t* (4)"];
  "inst:u_mm_fifo" -> "out:m_axis_*" [penwidth=3.2, color="#0f766e", fontcolor="#0f766e", fontname="Courier", fontsize=9, label="AXI4-Stream
m_axis_t* (4)"];
  "inst:u_s2_fifo" -> "inst:u_wr" [penwidth=3.2, color="#0f766e", fontcolor="#0f766e", fontname="Courier", fontsize=9, label="AXI4-Stream
wr_t* (3)"];
  "inst:u_wr" -> "out:m_axi_*" [penwidth=3.2, color="#0f766e", fontcolor="#0f766e", fontname="Courier", fontsize=9, label="AXI4
m_axi_* (14)"];
  "in:s_axil_*" -> "inst:u_regs" [penwidth=3.2, color="#0f766e", fontcolor="#0f766e", fontname="Courier", fontsize=9, label="AXI4-Lite
s_axil_* (17)"];
