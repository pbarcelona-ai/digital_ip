digraph "axi4_lite_mux_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>axi4_lite_mux</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/bus/axi4_lite_mux/src/axi4_lite_mux.sv; clocks / resets (not drawn): aclk, aresetn<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:m_axil_*" "in:s_axil_*" }
    "in:m_axil_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="m_axil_*\nm_axil_awready\nm_axil_wready\nm_axil_bresp\nm_axil_bvalid\nm_axil_arready\nm_axil_rdata\nm_axil_rresp\nm_axil_rvalid"];
    "in:s_axil_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="s_axil_*\ns_axil_awaddr\ns_axil_awvalid\ns_axil_wdata\ns_axil_wstrb\ns_axil_wvalid\ns_axil_bready\ns_axil_araddr\ns_axil_arvalid\ns_axil_rready"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:m_axil_*" "out:s_axil_*" }
    "out:m_axil_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="m_axil_*\nm_axil_awaddr\nm_axil_awvalid\nm_axil_wdata\nm_axil_wstrb\nm_axil_wvalid\nm_axil_bready\nm_axil_araddr\nm_axil_arvalid\nm_axil_rready"];
    "out:s_axil_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="s_axil_*\ns_axil_awready\ns_axil_wready\ns_axil_bresp\ns_axil_bvalid\ns_axil_arready\ns_axil_rdata\ns_axil_rresp\ns_axil_rvalid"];
  }
  subgraph cluster_b0 { label="always_ff @ line 123"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:ar_q" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="ar_q\n[ADDR_W-1:0]"];
    "sig:rst" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="rst"];
  }
  subgraph cluster_b1 { label="always_ff @ line 79"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:aw_done" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="aw_done"];
    "sig:aw_got" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="aw_got"];
    "sig:aw_q" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="aw_q\n[ADDR_W-1:0]"];
    "sig:w_done" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="w_done"];
    "sig:w_got" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="w_got"];
    "sig:w_q" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="w_q\n[31:0]"];
    "sig:ws_q" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="ws_q\n[3:0]"];
    "sig:wst" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="wst"];
  }
  "sig:rmiss" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="rmiss"];
  "sig:rmulti" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="rmulti"];
  "sig:rsel" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="rsel\n[NSLAVE-1:0]"];
  "sig:wmiss" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="wmiss"];
  "sig:wmulti" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="wmulti"];
  "sig:wsel" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="wsel\n[NSLAVE-1:0]"];
  "inst:u_wdec" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>axi4_lite_decoder</B><BR/><FONT COLOR="#4b5563">u_wdec</FONT>>];
  "inst:u_rdec" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>axi4_lite_decoder</B><BR/><FONT COLOR="#4b5563">u_rdec</FONT>>];
  "in:m_axil_*" -> "out:s_axil_*";
  "in:m_axil_*" -> "sig:aw_done";
  "in:m_axil_*" -> "sig:rst";
  "in:m_axil_*" -> "sig:w_done";
  "in:m_axil_*" -> "sig:wst";
  "in:s_axil_*" -> "out:m_axil_*";
  "in:s_axil_*" -> "out:s_axil_*";
  "in:s_axil_*" -> "sig:ar_q";
  "in:s_axil_*" -> "sig:aw_done";
  "in:s_axil_*" -> "sig:aw_got";
  "in:s_axil_*" -> "sig:aw_q";
  "in:s_axil_*" -> "sig:rst";
  "in:s_axil_*" -> "sig:w_done";
  "in:s_axil_*" -> "sig:w_got";
  "in:s_axil_*" -> "sig:w_q";
  "in:s_axil_*" -> "sig:ws_q";
  "in:s_axil_*" -> "sig:wst";
  "inst:u_rdec" -> "sig:rmiss";
  "inst:u_rdec" -> "sig:rmulti";
  "inst:u_rdec" -> "sig:rsel";
  "inst:u_wdec" -> "sig:wmiss";
  "inst:u_wdec" -> "sig:wmulti";
  "inst:u_wdec" -> "sig:wsel";
  "out:m_axil_*" -> "sig:aw_done";
  "out:m_axil_*" -> "sig:rst";
  "out:m_axil_*" -> "sig:w_done";
  "out:m_axil_*" -> "sig:wst";
  "out:s_axil_*" -> "out:m_axil_*";
  "out:s_axil_*" -> "out:s_axil_*";
  "out:s_axil_*" -> "sig:aw_done";
  "out:s_axil_*" -> "sig:aw_got";
  "out:s_axil_*" -> "sig:aw_q";
  "out:s_axil_*" -> "sig:w_done";
  "out:s_axil_*" -> "sig:w_got";
  "out:s_axil_*" -> "sig:w_q";
  "out:s_axil_*" -> "sig:ws_q";
  "out:s_axil_*" -> "sig:wst";
  "sig:ar_q" -> "inst:u_rdec";
  "sig:ar_q" -> "out:m_axil_*";
  "sig:aw_done" -> "out:m_axil_*";
  "sig:aw_done" -> "sig:wst";
  "sig:aw_got" -> "out:s_axil_*";
  "sig:aw_got" -> "sig:aw_done";
  "sig:aw_got" -> "sig:w_done";
  "sig:aw_got" -> "sig:wst";
  "sig:aw_q" -> "inst:u_wdec";
  "sig:aw_q" -> "out:m_axil_*";
  "sig:rmiss" -> "out:s_axil_*";
  "sig:rmiss" -> "sig:rst";
  "sig:rsel" -> "out:m_axil_*";
  "sig:rsel" -> "out:s_axil_*";
  "sig:rsel" -> "sig:rst";
  "sig:rst" -> "out:m_axil_*";
  "sig:rst" -> "out:s_axil_*";
  "sig:rst" -> "sig:ar_q";
  "sig:rst" -> "sig:rst";
  "sig:w_done" -> "out:m_axil_*";
  "sig:w_done" -> "sig:wst";
  "sig:w_got" -> "out:s_axil_*";
  "sig:w_got" -> "sig:aw_done";
  "sig:w_got" -> "sig:w_done";
  "sig:w_got" -> "sig:wst";
  "sig:w_q" -> "out:m_axil_*";
  "sig:wmiss" -> "out:s_axil_*";
  "sig:wmiss" -> "sig:aw_done";
  "sig:wmiss" -> "sig:w_done";
  "sig:wmiss" -> "sig:wst";
  "sig:ws_q" -> "out:m_axil_*";
  "sig:wsel" -> "out:m_axil_*";
  "sig:wsel" -> "out:s_axil_*";
  "sig:wsel" -> "sig:wst";
  "sig:wst" -> "out:m_axil_*";
  "sig:wst" -> "out:s_axil_*";
  "sig:wst" -> "sig:aw_done";
