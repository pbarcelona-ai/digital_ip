digraph "packet_parser_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>packet_parser</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/bus/packet_parser/src/packet_parser.sv; clocks / resets (not drawn): aclk, aresetn<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:cfg_mask_i" "in:cfg_value_i" "in:drop_nomatch_i" "in:m_axis_*" "in:s_axis_*" }
    "in:cfg_mask_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="cfg_mask_i\n[HDR_BYTES*8-1:0]"];
    "in:cfg_value_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="cfg_value_i\n[HDR_BYTES*8-1:0]"];
    "in:drop_nomatch_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="drop_nomatch_i"];
    "in:m_axis_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="m_axis_tready"];
    "in:s_axis_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="s_axis_*\ns_axis_tdata\ns_axis_tkeep\ns_axis_tlast\ns_axis_tvalid"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:drop_o" "out:hdr_o" "out:hdr_valid_o" "out:len_o" "out:len_valid_o" "out:m_axis_*" "out:match_o" "out:runt_o" "out:s_axis_*" }
    "out:drop_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="drop_o"];
    "out:hdr_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="hdr_o\n[HDR_BYTES*8-1:0]"];
    "out:hdr_valid_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="hdr_valid_o"];
    "out:len_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="len_o\n[15:0]"];
    "out:len_valid_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="len_valid_o"];
    "out:m_axis_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="m_axis_*\nm_axis_tdata\nm_axis_tkeep\nm_axis_tlast\nm_axis_tvalid"];
    "out:match_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="match_o"];
    "out:runt_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="runt_o"];
    "out:s_axis_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="s_axis_tready"];
  }
  subgraph cluster_b0 { label="always_comb @ line 59"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:hnow" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="hnow\n[HDR_BYTES*8-1:0]"];
    "sig:match_c" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="match_c"];
    "sig:pass_c" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="pass_c"];
  }
  subgraph cluster_b1 { label="always_ff @ line 74"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:cnt" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="cnt\n[15:0]"];
    "sig:hb" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="hb\n[$clog2(HB+1)-1:0]"];
    "sig:hreg" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="hreg\n[HDR_BYTES*8-1:0]"];
    "sig:pass_r" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="pass_r"];
  }
  "sig:acc" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="acc"];
  "sig:beat_bytes" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="beat_bytes\n[15:0]"];
  "sig:fwd_hdr" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="fwd_hdr"];
  "sig:fwd_pay" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="fwd_pay"];
  "sig:in_hdr" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="in_hdr"];
  "sig:last_hdr_beat" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="last_hdr_beat"];
  "sig:pass_now" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="pass_now"];
  "sig:short_end" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="short_end"];
  "in:cfg_mask_i" -> "sig:match_c";
  "in:cfg_value_i" -> "sig:match_c";
  "in:drop_nomatch_i" -> "sig:pass_c";
  "in:m_axis_*" -> "out:s_axis_*";
  "in:s_axis_*" -> "out:drop_o";
  "in:s_axis_*" -> "out:len_o";
  "in:s_axis_*" -> "out:len_valid_o";
  "in:s_axis_*" -> "out:m_axis_*";
  "in:s_axis_*" -> "sig:acc";
  "in:s_axis_*" -> "sig:beat_bytes";
  "in:s_axis_*" -> "sig:cnt";
  "in:s_axis_*" -> "sig:hb";
  "in:s_axis_*" -> "sig:hnow";
  "in:s_axis_*" -> "sig:hreg";
  "in:s_axis_*" -> "sig:pass_r";
  "in:s_axis_*" -> "sig:short_end";
  "out:s_axis_*" -> "sig:acc";
  "sig:acc" -> "out:drop_o";
  "sig:acc" -> "out:hdr_o";
  "sig:acc" -> "out:hdr_valid_o";
  "sig:acc" -> "out:len_o";
  "sig:acc" -> "out:len_valid_o";
  "sig:acc" -> "out:match_o";
  "sig:acc" -> "out:runt_o";
  "sig:acc" -> "sig:cnt";
  "sig:acc" -> "sig:hb";
  "sig:acc" -> "sig:hreg";
  "sig:acc" -> "sig:pass_r";
  "sig:beat_bytes" -> "out:len_o";
  "sig:beat_bytes" -> "sig:cnt";
  "sig:cnt" -> "out:len_o";
  "sig:cnt" -> "sig:cnt";
  "sig:fwd_hdr" -> "out:m_axis_*";
  "sig:fwd_hdr" -> "out:s_axis_*";
  "sig:fwd_pay" -> "out:m_axis_*";
  "sig:fwd_pay" -> "out:s_axis_*";
  "sig:hb" -> "sig:hb";
  "sig:hb" -> "sig:hnow";
  "sig:hb" -> "sig:hreg";
  "sig:hb" -> "sig:in_hdr";
  "sig:hb" -> "sig:last_hdr_beat";
  "sig:hnow" -> "out:hdr_o";
  "sig:hnow" -> "sig:match_c";
  "sig:hreg" -> "sig:hnow";
  "sig:in_hdr" -> "out:hdr_o";
  "sig:in_hdr" -> "out:hdr_valid_o";
  "sig:in_hdr" -> "out:match_o";
  "sig:in_hdr" -> "out:runt_o";
  "sig:in_hdr" -> "sig:fwd_hdr";
  "sig:in_hdr" -> "sig:fwd_pay";
  "sig:in_hdr" -> "sig:hb";
  "sig:in_hdr" -> "sig:hreg";
  "sig:in_hdr" -> "sig:last_hdr_beat";
  "sig:in_hdr" -> "sig:pass_r";
  "sig:in_hdr" -> "sig:short_end";
  "sig:last_hdr_beat" -> "out:hdr_o";
  "sig:last_hdr_beat" -> "out:hdr_valid_o";
  "sig:last_hdr_beat" -> "out:match_o";
  "sig:last_hdr_beat" -> "sig:hb";
  "sig:last_hdr_beat" -> "sig:pass_now";
  "sig:last_hdr_beat" -> "sig:pass_r";
  "sig:last_hdr_beat" -> "sig:short_end";
  "sig:match_c" -> "out:match_o";
  "sig:match_c" -> "sig:pass_c";
  "sig:pass_c" -> "sig:pass_now";
  "sig:pass_c" -> "sig:pass_r";
  "sig:pass_now" -> "out:drop_o";
  "sig:pass_r" -> "sig:fwd_pay";
  "sig:pass_r" -> "sig:pass_now";
  "sig:short_end" -> "out:drop_o";
  "sig:short_end" -> "out:hdr_o";
  "sig:short_end" -> "out:hdr_valid_o";
