digraph "axi_stream_fifo_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>axi_stream_fifo</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/bus/axi_stream_fifo/src/axi_stream_fifo.sv; clocks / resets (not drawn): aclk, aresetn<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:s_axis_*" }
    "in:s_axis_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="s_axis_*\ns_axis_tdata\ns_axis_tkeep\ns_axis_tlast\ns_axis_tuser\ns_axis_tvalid"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:level_o" "out:m_axis_*" }
    "out:level_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="level_o\n[$clog2(DEPTH)+1:0]"];
    "out:m_axis_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="m_axis_*\nm_axis_tdata\nm_axis_tkeep\nm_axis_tlast\nm_axis_tuser\nm_axis_tvalid"];
  }
  "sig:mu" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="mu"];
  "sig:pd" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="pd\n[PW-1:0]"];
  "sig:qd" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="qd\n[PW-1:0]"];
  "inst:u_fifo" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>ip_axis_fifo</B><BR/><FONT COLOR="#4b5563">u_fifo</FONT>>];
  "in:s_axis_*" -> "sig:pd";
  "inst:u_fifo" -> "out:level_o";
  "inst:u_fifo" -> "sig:mu";
  "inst:u_fifo" -> "sig:qd";
  "sig:pd" -> "inst:u_fifo";
  "sig:qd" -> "out:m_axis_*";
  "inst:u_fifo" -> "out:m_axis_*" [penwidth=3.2, color="#0f766e", fontcolor="#0f766e", fontname="Courier", fontsize=9, label="AXI4-Stream
m_axis_t* (3)"];
  "in:s_axis_*" -> "inst:u_fifo" [penwidth=3.2, color="#0f766e", fontcolor="#0f766e", fontname="Courier", fontsize=9, label="AXI4-Stream
s_axis_t* (3)"];
}
