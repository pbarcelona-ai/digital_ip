digraph "lfsr_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>lfsr</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/integrity/lfsr/src/lfsr.sv; clocks / resets (not drawn): clk, rst_n<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:en_i" "in:load_i" "in:seed_i" }
    "in:en_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="en_i"];
    "in:load_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="load_i"];
    "in:seed_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="seed_i\n[WIDTH-1:0]"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:bit_o" "out:lockup_o" "out:state_o" }
    "out:bit_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="bit_o\n[STEPS-1:0]"];
    "out:lockup_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="lockup_o"];
    "out:state_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="state_o\n[WIDTH-1:0]"];
  }
  subgraph cluster_b0 { label="always_comb @ line 35"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:bits" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="bits\n[STEPS-1:0]"];
    "sig:nxt" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="nxt\n[WIDTH-1:0]"];
    "sig:s" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="s\n[WIDTH-1:0]"];
  }
  "in:en_i" -> "out:state_o";
  "in:load_i" -> "out:lockup_o";
  "in:load_i" -> "out:state_o";
  "in:seed_i" -> "out:lockup_o";
  "in:seed_i" -> "out:state_o";
  "out:state_o" -> "sig:s";
  "sig:bits" -> "out:bit_o";
  "sig:nxt" -> "out:state_o";
  "sig:s" -> "sig:bits";
  "sig:s" -> "sig:nxt";
  "sig:s" -> "sig:s";
}
