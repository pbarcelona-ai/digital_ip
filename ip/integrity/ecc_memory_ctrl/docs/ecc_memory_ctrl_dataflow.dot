digraph "ecc_memory_ctrl_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>ecc_memory_ctrl</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from ip/integrity/ecc_memory_ctrl/src/ecc_memory_ctrl.sv; clocks / resets (not drawn): clk, rst_n<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:addr_i" "in:clr_i" "in:inject_i" "in:req_i" "in:wdata_i" "in:we_i" }
    "in:addr_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="addr_i\n[$clog2(DEPTH)-1:0]"];
    "in:clr_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="clr_i"];
    "in:inject_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="inject_i\n[CODE_W-1:0]"];
    "in:req_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="req_i"];
    "in:wdata_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="wdata_i\n[DATA_W-1:0]"];
    "in:we_i" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="we_i"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:ded_count_o" "out:ded_o" "out:err_addr_o" "out:rdata_o" "out:ready_o" "out:rvalid_o" "out:sec_count_o" "out:sec_o" }
    "out:ded_count_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="ded_count_o\n[CNT_W-1:0]"];
    "out:ded_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="ded_o"];
    "out:err_addr_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="err_addr_o\n[$clog2(DEPTH)-1:0]"];
    "out:rdata_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="rdata_o\n[DATA_W-1:0]"];
    "out:ready_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="ready_o"];
    "out:rvalid_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="rvalid_o"];
    "out:sec_count_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="sec_count_o\n[CNT_W-1:0]"];
    "out:sec_o" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="sec_o"];
  }
  subgraph cluster_b0 { label="always_ff @ line 66"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:mem" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="mem\n[CODE_W-1:0] x [0:DEPTH-1]"];
    "sig:mem_q" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="mem_q\n[CODE_W-1:0]"];
  }
  subgraph cluster_b1 { label="always_ff @ line 71"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:rd1_addr" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="rd1_addr\n[AW-1:0]"];
    "sig:rd1_v" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="rd1_v"];
    "sig:scrub_addr" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="scrub_addr\n[AW-1:0]"];
    "sig:scrub_code" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="scrub_code\n[CODE_W-1:0]"];
    "sig:scrub_wr" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="scrub_wr"];
  }
  "sig:acc" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="acc"];
  "sig:dec_data" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="dec_data\n[DATA_W-1:0]"];
  "sig:dec_ded" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="dec_ded"];
  "sig:dec_sec" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="dec_sec"];
  "sig:dec_syn" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="dec_syn\n[R-1:0]"];
  "sig:do_rd" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="do_rd"];
  "sig:do_wr" [shape=ellipse, style="filled", fillcolor="#f3f4f6", color="#6b7280", label="do_wr"];
  "sig:enc" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="enc\n[CODE_W-1:0]"];
  "sig:enc_scrub" [shape=ellipse, style="filled", fillcolor="#fff7ed", color="#c2410c", label="enc_scrub\n[CODE_W-1:0]"];
  "inst:u_enc" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>ecc_encoder</B><BR/><FONT COLOR="#4b5563">u_enc</FONT>>];
  "inst:u_dec" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>ecc_decoder</B><BR/><FONT COLOR="#4b5563">u_dec</FONT>>];
  "inst:u_enc_scrub" [shape=box, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>ecc_encoder</B><BR/><FONT COLOR="#4b5563">u_enc_scrub</FONT>>];
  "in:addr_i" -> "sig:mem";
  "in:addr_i" -> "sig:mem_q";
  "in:addr_i" -> "sig:rd1_addr";
  "in:clr_i" -> "out:ded_count_o";
  "in:clr_i" -> "out:sec_count_o";
  "in:inject_i" -> "sig:mem";
  "in:req_i" -> "sig:acc";
  "in:wdata_i" -> "inst:u_enc";
  "in:we_i" -> "sig:do_rd";
  "in:we_i" -> "sig:do_wr";
  "inst:u_dec" -> "sig:dec_data";
  "inst:u_dec" -> "sig:dec_ded";
  "inst:u_dec" -> "sig:dec_sec";
  "inst:u_dec" -> "sig:dec_syn";
  "inst:u_enc" -> "sig:enc";
  "inst:u_enc_scrub" -> "sig:enc_scrub";
  "out:ded_count_o" -> "out:ded_count_o";
  "out:ready_o" -> "sig:acc";
  "out:sec_count_o" -> "out:sec_count_o";
  "sig:acc" -> "sig:do_rd";
  "sig:acc" -> "sig:do_wr";
  "sig:dec_data" -> "inst:u_enc_scrub";
  "sig:dec_data" -> "out:rdata_o";
  "sig:dec_ded" -> "out:ded_count_o";
  "sig:dec_ded" -> "out:ded_o";
  "sig:dec_ded" -> "out:err_addr_o";
  "sig:dec_sec" -> "out:err_addr_o";
  "sig:dec_sec" -> "out:sec_count_o";
  "sig:dec_sec" -> "out:sec_o";
  "sig:dec_sec" -> "sig:scrub_addr";
  "sig:dec_sec" -> "sig:scrub_code";
  "sig:dec_sec" -> "sig:scrub_wr";
  "sig:do_rd" -> "sig:mem_q";
  "sig:do_rd" -> "sig:rd1_v";
  "sig:do_wr" -> "sig:mem";
  "sig:enc" -> "sig:mem";
  "sig:enc_scrub" -> "sig:scrub_code";
  "sig:mem" -> "sig:mem_q";
  "sig:mem_q" -> "inst:u_dec";
  "sig:rd1_addr" -> "out:err_addr_o";
  "sig:rd1_addr" -> "sig:scrub_addr";
  "sig:rd1_v" -> "out:ded_count_o";
  "sig:rd1_v" -> "out:ded_o";
  "sig:rd1_v" -> "out:err_addr_o";
  "sig:rd1_v" -> "out:rdata_o";
  "sig:rd1_v" -> "out:ready_o";
  "sig:rd1_v" -> "out:rvalid_o";
  "sig:rd1_v" -> "out:sec_count_o";
  "sig:rd1_v" -> "out:sec_o";
  "sig:rd1_v" -> "sig:scrub_addr";
  "sig:rd1_v" -> "sig:scrub_code";
  "sig:rd1_v" -> "sig:scrub_wr";
  "sig:scrub_addr" -> "sig:mem";
  "sig:scrub_code" -> "sig:mem";
  "sig:scrub_wr" -> "out:ready_o";
  "sig:scrub_wr" -> "sig:mem";
}
