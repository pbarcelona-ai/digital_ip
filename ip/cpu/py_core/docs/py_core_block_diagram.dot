// ***************
// Filename: py_core_block_diagram.dot
// Author: FPGA Cores 4 U
// Description: Micro-architecture block diagram of py_core, the Python-bytecode stack
//   machine: fetch / decode / control, operand stack, locals frames, return stack, globals,
//   constant pool, integer ALU, mem32 bus unit (AXI4-Lite master), interrupt and trap units.
//   Signal names from py_core.sv / py_core_pkg.sv. Blocks are pinned to a grid and edges are
//   routed around them (neato, splines=true): no line passes over or behind a block.
//   Render: neato -Tsvg py_core_block_diagram.dot -o py_core_block_diagram.svg
//   The control state machine is in py_core_fsm.dot.
// Date: 2026-10-08
// ***************
digraph py_core {
  layout=neato;
  graph [splines=true, overlap=false, sep="+14", esep="+8", bgcolor="white", pad=0.4, fontname="Helvetica", labelloc=t, labeljust=l,
         label=<<FONT POINT-SIZE="22"><B>py_core</B></FONT><FONT POINT-SIZE="13">  Python-bytecode stack machine (multi-cycle, 2 + operand-byte clocks per instruction)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">Values are 34-bit tagged pyval_t (bit 0 = 1: small int, else None / True / False / heap reference). Signal names from py_core.sv. Purple = AXI4-Lite, red = interrupt / trap, dashed = control. State machine: py_core_fsm.svg.</FONT><BR ALIGN="LEFT"/>>];
  node [shape=plaintext, fontname="Helvetica", fontsize=10];
  edge [color="#374151", arrowsize=0.7, penwidth=1.2, fontname="Helvetica", fontsize=9];
  codemem [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e0f2fe" COLOR="#0369a1"><TR><TD><B>code memory</B><BR/>2**CODE_AW bytes, 1-clock read<BR/>code_addr_o / code_data_i</TD></TR></TABLE>>, pos="0,7.3!"];
  constmem [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e0f2fe" COLOR="#0369a1"><TR><TD><B>constant pool</B><BR/>2**CONST_AW × 34 bit, 1-clock read<BR/>const_addr_o / const_data_i</TD></TR></TABLE>>, pos="0,2.4!"];
  pc [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ffffff" COLOR="#0369a1">
      <TR><TD><B>pc</B> [CODE_AW-1:0]</TD></TR><TR><TD><B>ipc</B> (current instruction)</TD></TR></TABLE>>, pos="5,7.3!"];
  dec [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ffffff" COLOR="#0369a1">
      <TR><TD><B>op</B> [7:0]</TD></TR><TR><TD><B>arg</B> [15:0] (imm8 / idx8 / abs16)</TD></TR>
      <TR><TD><B>nargs</B> = op_args(op): 0, 1, 2 operand bytes</TD></TR></TABLE>>, pos="5,4.8!"];
  ctl [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fef3c7" COLOR="#a16207">
      <TR><TD><B>control FSM</B> st (state_e)</TD></TR>
      <TR><TD ALIGN="LEFT">S_IDLE → S_FETCH → S_OP → [S_ARG0 → S_ARG1] → S_EXEC<BR ALIGN="LEFT"/>S_EXEC → S_CONST / S_WR / S_RD / S_DONE / S_TRAP<BR ALIGN="LEFT"/>(state diagram: py_core_fsm.svg)</TD></TR></TABLE>>, pos="10.5,7.3!"];
  stack [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ede9fe" COLOR="#7c3aed">
      <TR><TD><B>operand stack</B> stk[STACK_DEPTH] (flops)</TD></TR>
      <TR><TD><B>sp</B> = entries; <B>tos</B> = stk[sp-1], <B>tos1</B> = stk[sp-2]</TD></TR></TABLE>>, pos="10.5,4.8!"];
  alu [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ede9fe" COLOR="#7c3aed">
      <TR><TD><B>integer ALU</B> (fast path) alu_r = a op b</TD></TR>
      <TR><TD ALIGN="LEFT">a = small_val(tos1), b = small_val(tos)<BR ALIGN="LEFT"/>ADD SUB AND OR XOR LSHIFT RSHIFT<BR ALIGN="LEFT"/>LT EQ NE GT LE GE → bool (alu_cmp)<BR ALIGN="LEFT"/>alu_ovf, lshift_ovf, shift_neg → trap</TD></TR>
      <TR><TD>truthiness: tos_known, tos_truthy</TD></TR></TABLE>>, pos="10.5,2.4!"];
  locals [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ede9fe" COLOR="#7c3aed">
      <TR><TD><B>locals</B> [N_FRAMES × N_LOCALS] (LUT RAM)</TD></TR>
      <TR><TD>lidx = {fp, arg} : LOAD_FAST / STORE_FAST</TD></TR></TABLE>>, pos="16,4.8!"];
  frames [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ede9fe" COLOR="#7c3aed">
      <TR><TD><B>call frames</B></TD></TR>
      <TR><TD><B>fp</B> current frame, frame_full</TD></TR>
      <TR><TD><B>rstk</B>[N_FRAMES] return addresses<BR/>CALL pushes, RETURN pops</TD></TR></TABLE>>, pos="16,7.3!"];
  globals [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ede9fe" COLOR="#7c3aed"><TR><TD><B>globals</B>[N_GLOBALS]<BR/>LOAD_GLOBAL / STORE_GLOBAL<BR/>(shared with interrupt handlers)</TD></TR></TABLE>>, pos="16,2.4!"];
  bus [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ede9fe" COLOR="#7c3aed">
      <TR><TD><B>mem32 bus unit</B> (S_WR / S_RD)</TD></TR>
      <TR><TD ALIGN="LEFT">MEM32_STORE: a = tos1, v = tos<BR ALIGN="LEFT"/>MEM32_LOAD: a = tos → push rdata<BR ALIGN="LEFT"/>addr_ok, data_ok, raddr_ok; aw_done, w_done</TD></TR></TABLE>>, pos="10.5,0!"];
  irq [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fee2e2" COLOR="#dc2626">
      <TR><TD><B>interrupt unit</B></TD></TR>
      <TR><TD ALIGN="LEFT">ie (IRQ_ENABLE / IRQ_DISABLE)<BR ALIGN="LEFT"/>irq_vec, vec_set (SET_IRQ_VECTOR)<BR ALIGN="LEFT"/>in_irq, irq_fp, saved_sp<BR ALIGN="LEFT"/>take_irq = irq_i ∧ ie ∧ vec_set ∧ ¬in_irq ∧ ¬frame_full<BR ALIGN="LEFT"/>RETURN_FROM_IRQ restores sp</TD></TR></TABLE>>, pos="5,9.8!"];
  trap [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fee2e2" COLOR="#dc2626">
      <TR><TD><B>trap unit</B> trap_cause_o, trap_pc_o (= ipc), trap_op_o</TD></TR>
      <TR><TD ALIGN="LEFT">ILLEGAL, TYPE, OVERFLOW, STACK, BUS,<BR ALIGN="LEFT"/>INDEX, IRQ_STATE, FRAME<BR ALIGN="LEFT"/>core stalls; a helper emulates and resumes</TD></TR></TABLE>>, pos="21.5,6!"];
  p_ctl [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f3f4f6" COLOR="#6b7280">
      <TR><TD ALIGN="LEFT">start_i, resume_i, resume_pc_i</TD></TR>
      <TR><TD ALIGN="LEFT">busy_o, done_o, result_o[33:0]</TD></TR>
      <TR><TD ALIGN="LEFT">trap_o, trap_cause_o, trap_pc_o, trap_op_o</TD></TR></TABLE>>, pos="21.5,9.8!"];
  p_irq [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f3f4f6" COLOR="#6b7280"><TR><TD>irq_i (level), in_irq_o</TD></TR></TABLE>>, pos="0,9.8!"];
  p_axi [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f3f4f6" COLOR="#6b7280"><TR><TD>m_axil_* (AXI4-Lite master, 32-bit address)</TD></TR></TABLE>>, pos="16,0!"];
  legend [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2"><B>Groups</B></TD></TR><TR><TD BGCOLOR="#ffffff" WIDTH="18"> </TD><TD ALIGN="LEFT">fetch / decode (pc, op, arg)</TD></TR><TR><TD BGCOLOR="#fef3c7"> </TD><TD ALIGN="LEFT">control FSM</TD></TR><TR><TD BGCOLOR="#e0f2fe"> </TD><TD ALIGN="LEFT">py_soc memories</TD></TR><TR><TD BGCOLOR="#ede9fe"> </TD><TD ALIGN="LEFT">datapath</TD></TR><TR><TD BGCOLOR="#fee2e2"> </TD><TD ALIGN="LEFT">interrupt / trap</TD></TR><TR><TD BGCOLOR="#f3f4f6"> </TD><TD ALIGN="LEFT">ports</TD></TR></TABLE>>, pos="21.5,1.2!"];
  codemem -> dec [label="code_data_i (op, operand bytes)"];
  pc -> codemem [label="code_addr_o = pc"];
  dec -> constmem [label="const_addr_o = arg"];
  constmem -> stack [label="S_CONST: push const_data_i"];
  dec -> ctl [style=dashed, label="op, nargs"];
  ctl -> stack [style=dashed, label="push / pop, sp"];
  ctl -> pc [style=dashed, label="pc + 1"];
  ctl -> bus [style=dashed, label="S_WR / S_RD"];
  stack -> locals [dir=both, label="STORE_FAST / LOAD_FAST"];
  stack -> globals [dir=both, label="STORE_GLOBAL / LOAD_GLOBAL"];
  dec -> locals [label="arg (local index)"];
  frames -> locals [label="fp"];
  dec -> pc [label="JUMP / POP_JUMP_IF_*: pc = arg"];
  alu -> pc [label="tos_truthy", style=dashed];
  stack -> bus [label="address, data"];
  bus -> stack [label="rdata"];
  bus -> p_axi [color="#7c3aed", penwidth=2.5, dir=both, label="AW / W / B / AR / R"];
  p_irq -> irq [color="#dc2626"];
  irq -> pc [color="#dc2626", label="take_irq (in S_FETCH): rstk[fp] = pc, pc = irq_vec"];
  irq -> frames [color="#dc2626", label="handler frame irq_fp"];
  alu -> trap [color="#dc2626", style=dashed, label="overflow / type"];
  bus -> trap [color="#dc2626", style=dashed, label="SLVERR / DECERR"];
  frames -> trap [color="#dc2626", style=dashed, label="depth"];
  trap -> p_ctl [color="#dc2626"];
  stack -> p_ctl [label="RETURN_VALUE: result_o = tos"];
  p_ctl -> ctl [style=dashed, label="start_i / resume_i"];
  trap -> ctl [color="#dc2626", style=dashed, label="S_TRAP"];
  frames -> pc [dir=both, label="CALL: rstk[fp] = pc, fp + 1\nRETURN: pc = rstk[fp-1], fp - 1"];
  stack -> alu [dir=both, label="tos, tos1 ↓\npush alu_r ↑"];
}
