    "out:sdram_*" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="sdram_*\nsdram_clk\nsdram_cke\nsdram_cs_n\nsdram_ras_n\nsdram_cas_n\nsdram_we_n\nsdram_a\nsdram_ba\nsdram_dqm\nsdram_dq"];
    "out:wr_idle" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="wr_idle"];
    "out:wr_ready" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="wr_ready"];
  }
  subgraph cluster_b0 { label="always @ line 102"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
