    "in:rd_en" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="rd_en"];
    "in:sdram_*" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="sdram_dq\n[SDRAM_DQ_W-1:0]"];
    "in:wr_addr" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="wr_addr\n[ADDR_W-1:0]"];
    "in:wr_data" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="wr_data\n[PIX_W-1:0]"];
    "in:wr_en" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="wr_en"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
