digraph "fixed_recip_dataflow" {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.18, ranksep=0.9, fontname="Helvetica", newrank=true, labelloc=t, labeljust=l, label=<<FONT POINT-SIZE="18"><B>fixed_recip</B> data flow (RTL level)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#4b5563">signal names from image_processing/vision_system/ip/fixed_recip/src/fixed_recip.sv; clocks / resets (not drawn): clk, rst_n<BR ALIGN="LEFT"/>box with double border = register (always_ff), ellipse = combinational (assign / always_comb), yellow = sub-module instance; clusters = the always block that drives them<BR ALIGN="LEFT"/>thick teal line = protocol bus (AXI4-Stream / AXI4 / AXI4-Lite, ready and responses implied); a bus signal also used elsewhere is drawn separately</FONT><BR ALIGN="LEFT"/>>];
  node [fontname="Helvetica", fontsize=9];
  edge [color="#4b5563", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_in { label="inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=min; "in:operand" "in:start" }
    "in:operand" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="operand\n[W-1:0]"];
    "in:start" [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label="start"];
  }
  subgraph cluster_out { label="outputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#4b5563"; fontsize=10;
    { rank=max; "out:busy" "out:done" "out:result" }
    "out:busy" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="busy"];
    "out:done" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="done"];
    "out:result" [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label="result\n[W-1:0]"];
  }
  subgraph cluster_b0 { label="always_ff @ line 43"; style="rounded"; color="#c4b5fd"; fontcolor="#6d28d9"; fontsize=9;
    "sig:div_ext" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="div_ext\n[W:0]"];
    "sig:divisor" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="divisor\n[W-1:0]"];
    "sig:quot" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="quot\n[W:0]"];
    "sig:rem" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="rem\n[W:0]"];
    "sig:state" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="state"];
    "sig:step" [shape=box, peripheries=2, style="filled", fillcolor="#ede9fe", color="#7c3aed", label="step\n[$clog2(W+2)-1:0]"];
  }
  "in:operand" -> "sig:divisor";
  "in:start" -> "out:busy";
  "in:start" -> "sig:divisor";
  "in:start" -> "sig:quot";
  "in:start" -> "sig:rem";
  "in:start" -> "sig:state";
  "in:start" -> "sig:step";
  "sig:div_ext" -> "sig:quot";
  "sig:div_ext" -> "sig:rem";
  "sig:divisor" -> "sig:div_ext";
  "sig:quot" -> "out:result";
  "sig:quot" -> "sig:quot";
  "sig:rem" -> "sig:quot";
  "sig:rem" -> "sig:rem";
  "sig:state" -> "out:busy";
  "sig:state" -> "out:done";
  "sig:state" -> "out:result";
  "sig:state" -> "sig:div_ext";
  "sig:state" -> "sig:divisor";
  "sig:state" -> "sig:quot";
  "sig:state" -> "sig:rem";
  "sig:state" -> "sig:state";
  "sig:state" -> "sig:step";
  "sig:step" -> "sig:state";
  "sig:step" -> "sig:step";
}
